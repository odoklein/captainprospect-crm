# Copied into every agency instance. Fill in what you share across agencies.

# Transactional email (invitations, password resets). Shared sending domain, the agency's
# name is the display name (the brand's senderName).
SYSTEM_SMTP_HOST=smtp.example.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=notifications@crm-agence.fr
SYSTEM_SMTP_PASS=CHANGE_ME

# Mailbox OAuth: one Google and one Microsoft app, through the relay (docs/WHITE_LABEL.md §13).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_RELAY_URL=https://auth.crm-agence.fr

# Realtime: a socket server that checks the handshake token (docs/WHITE_LABEL.md §14),
# or one per agency.
SOCKET_URL=https://socket.crm-agence.fr
SOCKET_PATH=/socket.io

# Platform AI keys, metered per agency later.
MISTRAL_API_KEY=
