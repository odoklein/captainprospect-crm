# Where agencies are created. Copy to provision.infra.env (git-ignored) and fill in.
# Never commit the real file: it holds admin credentials.

# Neutral platform domain: <slug>.<this> works at once (wildcard DNS -> the server),
# and agencies point a CNAME at edge.<this> for their own domain.
PROVISION_PLATFORM_DOMAIN=crm-agence.fr

# Postgres cluster. The admin URL creates roles and databases (CREATEROLE + CREATEDB, or superuser).
PROVISION_PG_ADMIN_URL=postgresql://postgres:ADMIN_PASSWORD@pg.example.internal:5432/postgres
# Host and port the agency containers use to reach it (default: those of the admin URL).
# PROVISION_PG_APP_HOST=pg
# PROVISION_PG_APP_PORT=5432
# Extra connection parameters appended to every agency DATABASE_URL.
# PROVISION_PG_PARAMS=sslmode=require

# MinIO. With PROVISION_MINIO_MC_ALIAS (an `mc alias set` with admin rights) each agency gets
# a key limited to its own bucket. Without it every agency receives this admin key: fine for a
# test agency, not for a customer.
PROVISION_MINIO_ENDPOINT=https://minio.example.com
PROVISION_MINIO_ACCESS_KEY_ID=ADMIN_ACCESS_KEY
PROVISION_MINIO_SECRET_ACCESS_KEY=ADMIN_SECRET_KEY
# PROVISION_MINIO_REGION=us-east-1
# PROVISION_MINIO_MC_ALIAS=platform

# Dokploy (Settings > Profile > API/CLI > generate a key).
PROVISION_DOKPLOY_URL=https://dokploy.example.com
PROVISION_DOKPLOY_API_KEY=DOKPLOY_API_KEY
# Project that holds the agencies (created when missing).
# PROVISION_DOKPLOY_PROJECT=agencies
# Only if the project's environment cannot be found automatically.
# PROVISION_DOKPLOY_ENVIRONMENT_ID=

# Images (built by .github/workflows/image.yml). Private packages need a token with read:packages.
# PROVISION_IMAGE_REPO=ghcr.io/odoklein/captainprospect-crm
PROVISION_REGISTRY_USER=github-username
PROVISION_REGISTRY_TOKEN=ghp_read_packages_token

# How migrations and the seed run: "docker" (the migrate image, needs `docker login ghcr.io`
# on this machine) or "local" (prisma from this checkout, which must be at the same commit as the tag).
# PROVISION_MIGRATE_MODE=docker

# Public proxy that owns ports 80/443 (here: Coolify's Traefik, which watches this directory).
# Each agency gets agency-<slug>.yml routing its hosts to Dokploy's Traefik. Run the script on the server.
# PROVISION_PROXY_DYNAMIC_DIR=/data/coolify/proxy/dynamic
# Docker network the migrate container joins to reach Postgres when it has no public port.
# PROVISION_DOCKER_NETWORK=dokploy-network

# KEY=VALUE file copied into every agency (SMTP, platform AI keys, Google/Microsoft OAuth apps,
# OAUTH_RELAY_URL, SOCKET_URL). Per-agency keys (database, secrets, URL, bucket) cannot be overridden by it.
PROVISION_SHARED_ENV=shared.example.env
