@@ -0,0 +1,73 @@
+"use client";
+
+import { Building2, FileText, ListChecks, MoreHorizontal, Plus, ShieldCheck, Trash2, Users } from "lucide-react";
+import { ConfirmModal } from "@/components/ui";
+import {
+    DropdownMenu,
+    DropdownMenuContent,
+    DropdownMenuItem,
+    DropdownMenuLabel,
+    DropdownMenuSeparator,
+    DropdownMenuSub,
+    DropdownMenuSubContent,
+    DropdownMenuSubTrigger,
+    DropdownMenuTrigger,
+} from "@/components/ui/shadcn/dropdown-menu";
+import type { ClientManagementSection } from "@/components/manager/ClientManagementDrawer";
+import { useDeleteClient } from "@/lib/manager/workspace/client/mutations";
+import type { Client } from "@/lib/manager/workspace/client/types";
+import { PageTemplateItems, type PageCreation } from "./PageTemplateItems";
+
+/** Crumb actions of the client home and views: « … » menu (manage, new page, delete) and « Nouvelle mission ». */
+export function ClientActions({ client, pages, onManage, onOpenOnboarding, onDelete, onNewMission }: {
+    client: Client;
+    pages: PageCreation;
+    onManage: (section: ClientManagementSection) => void;
+    onOpenOnboarding: () => void;
+    onDelete: () => void;
+    onNewMission: () => void;
+}) {
+    return (
+        <>
+            <DropdownMenu>
+                <DropdownMenuTrigger asChild><button className="cw-button cw-quiet cw-icon-button" aria-label={`Actions sur ${client.name}`}><MoreHorizontal /></button></DropdownMenuTrigger>
+                <DropdownMenuContent align="end" className="w-64">
+                    <DropdownMenuLabel>Gérer le client</DropdownMenuLabel>
+                    <DropdownMenuItem onSelect={() => onManage("profile")}><Building2 />Informations du client</DropdownMenuItem>
+                    <DropdownMenuItem onSelect={() => onManage("contacts")}><Users />Interlocuteurs et agendas</DropdownMenuItem>
+                    <DropdownMenuItem onSelect={() => onManage("portal")}><ShieldCheck />Accès au portail</DropdownMenuItem>
+                    <DropdownMenuSeparator />
+                    <DropdownMenuSub>
+                        <DropdownMenuSubTrigger><FileText />Nouvelle page</DropdownMenuSubTrigger>
+                        <DropdownMenuSubContent className="w-56"><PageTemplateItems disabled={pages.pending} onPick={(template) => pages.create(template)} /></DropdownMenuSubContent>
+                    </DropdownMenuSub>
+                    <DropdownMenuItem onSelect={onOpenOnboarding}><ListChecks />Suivre l’intégration</DropdownMenuItem>
+                    <DropdownMenuSeparator />
+                    <DropdownMenuItem variant="destructive" onSelect={onDelete}><Trash2 />Supprimer le client</DropdownMenuItem>
+                </DropdownMenuContent>
+            </DropdownMenu>
+            <button className="cw-button cw-primary" onClick={onNewMission}><Plus /> Nouvelle mission</button>
+        </>
+    );
+}
+
+/** « Supprimer le client » confirmation; on success the shell closes the client. */
+export function DeleteClientConfirm({ client, isOpen, onClose, onDeleted }: { client: Client; isOpen: boolean; onClose: () => void; onDeleted: () => void }) {
+    const remove = useDeleteClient(client, () => {
+        onClose();
+        onDeleted();
+    });
+    return (
+        <ConfirmModal
+            isOpen={isOpen}
+            onClose={() => !remove.isPending && onClose()}
+            onConfirm={() => remove.mutate()}
+            title="Supprimer le client"
+            message={`Êtes-vous sûr de vouloir supprimer "${client.name}" ? Cette action supprimera définitivement le client et toutes les données associées (missions, campagnes, onboarding, utilisateurs liés, etc.) et ne peut pas être annulée.`}
+            confirmText="Supprimer définitivement"
+            cancelText="Annuler"
+            variant="danger"
+            isLoading={remove.isPending}
+        />
+    );
+}
diff --git a/components/manager/workspace/client/ClientStatusMenu.tsx b/components/manager/workspace/client/ClientStatusMenu.tsx
new file mode 100644
index 0000000..f1713f9
--- /dev/null
+++ b/components/manager/workspace/client/ClientStatusMenu.tsx
@@ -0,0 +1,38 @@
+"use client";
+
+import { ChevronDown } from "lucide-react";
+import {
+    DropdownMenu,
+    DropdownMenuContent,
+    DropdownMenuLabel,
+    DropdownMenuRadioGroup,
+    DropdownMenuRadioItem,
+    DropdownMenuTrigger,
+} from "@/components/ui/shadcn/dropdown-menu";
+import { useUpdateClient } from "@/lib/manager/workspace/client/mutations";
+import type { Client, ClientStatus } from "@/lib/manager/workspace/client/types";
+import { CLIENT_STATUS_CONFIG } from "./constants";
+
+/** Rail « Statut » (Actif / En pause / Arrêté). Optimistic: the pill changes at once, rolls back on error. */
+export function ClientStatusMenu({ client, status, onUpdate }: { client: Client; status: ClientStatus; onUpdate?: (client: Client) => void }) {
+    const update = useUpdateClient(client, onUpdate);
+    const info = CLIENT_STATUS_CONFIG[status];
+    const tone = status === "ACTIVE" ? "success" : status === "PAUSED" ? "warning" : undefined;
+    return (
+        <DropdownMenu>
+            <DropdownMenuTrigger asChild>
+                <button className="cw-prop-button" disabled={update.isPending} aria-label={`Statut du client : ${info.label}. Changer`}>
+                    <span className="cw-pill" data-tone={tone}><i />{info.label}</span><ChevronDown aria-hidden />
+                </button>
+            </DropdownMenuTrigger>
+            <DropdownMenuContent align="end" className="w-44">
+                <DropdownMenuLabel>Statut du client</DropdownMenuLabel>
+                <DropdownMenuRadioGroup value={status} onValueChange={(value) => update.mutate({ patch: { status: value as ClientStatus }, optimistic: true })}>
+                    {(Object.keys(CLIENT_STATUS_CONFIG) as ClientStatus[]).map((key) => (
+                        <DropdownMenuRadioItem key={key} value={key}>{CLIENT_STATUS_CONFIG[key].label}</DropdownMenuRadioItem>
+                    ))}
+                </DropdownMenuRadioGroup>
+            </DropdownMenuContent>
+        </DropdownMenu>
+    );
+}
diff --git a/components/manager/workspace/client/HomeView.tsx b/components/manager/workspace/client/HomeView.tsx
new file mode 100644
index 0000000..80842ac
--- /dev/null
+++ b/components/manager/workspace/client/HomeView.tsx
@@ -0,0 +1,157 @@
+"use client";
+
+import { useState } from "react";
+import { Building2, ChevronRight, FileText, ListChecks, Loader2, MessageSquare, Plus, RefreshCw, Users } from "lucide-react";
+import { DropdownMenu, DropdownMenuContent, DropdownMenuLabel, DropdownMenuTrigger } from "@/components/ui/shadcn/dropdown-menu";
+import { InboxItem, type WorkspaceClient, type WorkspaceLocation } from "@/components/manager/workspace/InboxItem";
+import { useClientPages } from "@/components/manager/workspace/clientPages";
+import type { ClientManagementSection } from "@/components/manager/ClientManagementDrawer";
+import { useClientDetail, useClientSessions, useOnboardingProgress } from "@/lib/manager/workspace/client/queries";
+import { useUpdateMissionStatus } from "@/lib/manager/workspace/client/mutations";
+import type { Client, ClientSdrFeedbackInsight, MissionLite } from "@/lib/manager/workspace/client/types";
+import { cn } from "@/lib/utils";
+import { ClientStatusMenu } from "./ClientStatusMenu";
+import { MissionLine } from "./MissionLine";
+import { PageTemplateItems, type PageCreation } from "./PageTemplateItems";
+import { draftCount, formatRelative } from "./format";
+import { useClientModel } from "./model";
+import type { TabId } from "./constants";
+
+/** Client home (`espace=missions`): À traiter, missions by stage, pages; properties rail. */
+export function HomeView({ client, allClients, onUpdate, go, openMission, setActiveTab, onNewMission, onManage, pages }: {
+    client: Client;
+    allClients: WorkspaceClient[];
+    onUpdate?: (client: Client) => void;
+    go: (location: WorkspaceLocation | null, focus?: string) => void;
+    openMission: (id: string | null, tab?: string) => void;
+    setActiveTab: (tab: TabId) => void;
+    onNewMission: () => void;
+    onManage: (section: ClientManagementSection) => void;
+    pages: PageCreation;
+}) {
+    const [showClosedMissions, setShowClosedMissions] = useState(false);
+    const { data: detail, isLoading, isError, refetch } = useClientDetail(client.id);
+    const { data: onboarding } = useOnboardingProgress(client.id);
+    const { data: pageList = [] } = useClientPages(client.id);
+    const { data: sessions = [] } = useClientSessions(client.id);
+    const missionStatus = useUpdateMissionStatus(client.id);
+    const { missions, closedMissions, usersList, interlocuteurs, clientStatus, workspaceMissions, clientAttention, attentionByMission } = useClientModel(client, detail, allClients);
+
+    const sdrFeedback = (detail?.insights?.sdrFeedback ?? []) as ClientSdrFeedbackInsight[];
+    const activeMissionsCount = missions.filter((m) => m.status === "ACTIVE").length;
+    const onboardingProgress = onboarding?.progress;
+    const mainContact = interlocuteurs[0];
+    const missionGroups = [
+        { id: "ACTIVE", label: "En cours", items: missions.filter((mission) => mission.status === "ACTIVE") },
+        { id: "DRAFT", label: "En préparation", items: missions.filter((mission) => mission.status === "DRAFT") },
+        { id: "PAUSED", label: "En pause", items: missions.filter((mission) => mission.status === "PAUSED") },
+    ].filter((group) => group.items.length);
+
+    const missionLine = (mission: MissionLite) => (
+        <MissionLine
+            key={mission.id}
+            mission={mission}
+            summary={workspaceMissions.get(mission.id)}
+            attention={attentionByMission.get(mission.id)}
+            onOpen={(tab) => openMission(mission.id, tab)}
+            onStatusChange={(next) => missionStatus.mutate({ mission, status: next })}
+        />
+    );
+
+    return (
+        <div className="cw-layout">
+            <main className="cw-doc" aria-labelledby="cw-client-title">
+                <header className="cw-doc-head">
+                    <span className="cw-eyebrow"><Building2 aria-hidden /><span>Client{client.industry ? ` · ${client.industry}` : ""}</span></span>
+                    <div className="cw-client-identity">
+                        <span className="cw-monogram cw-monogram-large" aria-hidden>{client.name[0]?.toUpperCase() || "?"}</span>
+                        <h1 id="cw-client-title" className="cw-doc-title" tabIndex={-1} data-focus-key="heading">{client.name}</h1>
+                    </div>
+                    <p className="cw-doc-lede">
+                        {missions.length} mission{missions.length > 1 ? "s" : ""} · {activeMissionsCount} en cours
+                        {draftCount(missions) > 0 && <> · {draftCount(missions)} en préparation</>}
+                    </p>
+                </header>
+
+                <div className="cw-sections">
+                    {clientAttention.length > 0 && <section className="cw-section" aria-labelledby="cw-client-attention">
+                        <div className="cw-section-head"><h2 id="cw-client-attention">À traiter <small>{clientAttention.length}</small></h2></div>
+                        <div className="cw-inbox">{clientAttention.map((item) => <InboxItem key={item.mission.id} item={item} hideClient onOpen={(location) => go(location)} />)}</div>
+                    </section>}
+
+                    <section className="cw-section cw-mission-list" aria-labelledby="cw-client-missions">
+                        <div className="cw-section-head">
+                            <h2 id="cw-client-missions">Missions <small>{missions.length}</small></h2>
+                            <button className="cw-button" data-size="sm" onClick={onNewMission}><Plus /> Nouvelle mission</button>
+                        </div>
+                        {isLoading ? <div className="cw-empty" role="status"><Loader2 className="animate-spin" />Chargement des missions…</div>
+                            : isError ? <div className="cw-empty" role="alert"><p>Impossible de charger les missions.</p><button className="cw-button" onClick={() => refetch()}><RefreshCw /> Réessayer</button></div>
+                            : missions.length === 0 ? <p className="cw-empty-line"><span>Aucune mission pour ce client.</span><button className="cw-button cw-primary" data-size="sm" onClick={onNewMission}><Plus /> Créer la première mission</button></p>
+                            : <>
+                                {missionGroups.map((group) => <div key={group.id} className="cw-mission-group">
+                                    <h3 className="cw-mission-group-title">{group.label} <span className="cw-count">{group.items.length}</span></h3>
+                                    <div className="cw-rows">{group.items.map(missionLine)}</div>
+                                </div>)}
+                                {closedMissions.length > 0 && <div className="cw-mission-group">
+                                    <button className="cw-mission-group-title" onClick={() => setShowClosedMissions((value) => !value)} aria-expanded={showClosedMissions}>
+                                        <ChevronRight aria-hidden className={cn("h-3.5 w-3.5 transition-transform", showClosedMissions && "rotate-90")} />Clôturées <span className="cw-count">{closedMissions.length}</span>
+                                    </button>
+                                    {showClosedMissions && <div className="cw-rows">{closedMissions.map(missionLine)}</div>}
+                                </div>}
+                            </>}
+                    </section>
+
+                    <section className="cw-section" aria-labelledby="cw-client-pages">
+                        <div className="cw-section-head">
+                            <h2 id="cw-client-pages">Pages <small>{pageList.length}</small></h2>
+                            <DropdownMenu>
+                                <DropdownMenuTrigger asChild><button className="cw-button" data-size="sm" disabled={pages.pending}>{pages.pending ? <Loader2 className="animate-spin" /> : <Plus />} Nouvelle page</button></DropdownMenuTrigger>
+                                <DropdownMenuContent align="end" className="w-56"><DropdownMenuLabel>Partir de</DropdownMenuLabel><PageTemplateItems disabled={pages.pending} onPick={(template) => pages.create(template)} /></DropdownMenuContent>
+                            </DropdownMenu>
+                        </div>
+                        {pageList.length ? <div className="cw-rows">
+                            {pageList.slice(0, 6).map((page) => {
+                                const linked = missions.find((mission) => mission.id === page.missionId);
+                                return <div key={page.id} className="cw-row" data-interactive onClick={() => go({ client: client.id, page: page.id })}>
+                                    <span className="cw-row-icon"><FileText aria-hidden /></span>
+                                    <div className="cw-row-main">
+                                        <button className="cw-row-title" onClick={(event) => { event.stopPropagation(); go({ client: client.id, page: page.id }); }}>{page.title || "Sans titre"}</button>
+                                        <small>{linked ? `${linked.name} · ` : ""}Modifiée {page.updatedBy ? `par ${page.updatedBy.name}, ` : ""}{formatRelative(page.updatedAt).replace(/^\p{Lu}/u, (letter) => letter.toLowerCase())}</small>
+                                    </div>
+                                    <ChevronRight className="cw-row-arrow" aria-hidden />
+                                </div>;
+                            })}
+                        </div> : <p className="cw-empty-line"><span>Briefs, comptes rendus et procédures de l’équipe, rangés avec le client.</span></p>}
+                    </section>
+                </div>
+            </main>
+
+            <aside className="cw-rail" aria-label="Propriétés du client">
+                <section className="cw-rail-section">
+                    <h2 className="cw-rail-title">Propriétés</h2>
+                    <dl className="cw-props">
+                        <div><dt>Statut</dt><dd><ClientStatusMenu client={client} status={clientStatus} onUpdate={onUpdate} /></dd></div>
+                        <div><dt>Secteur</dt><dd>{client.industry || <span className="cw-prop-empty">Non renseigné</span>}</dd></div>
+                        <div><dt>Contact</dt><dd>{mainContact ? <span title={mainContact.jobTitle || undefined}>{mainContact.firstName} {mainContact.lastName}</span> : <button className="cw-prop-button" onClick={() => onManage("contacts")}><span className="cw-prop-empty">Ajouter</span></button>}</dd></div>
+                        <div><dt>Client depuis</dt><dd>{new Date(client.createdAt).toLocaleDateString("fr-FR", { month: "long", year: "numeric" })}</dd></div>
+                    </dl>
+                </section>
+                <section className="cw-rail-section">
+                    <h2 className="cw-rail-title">Intégration {onboardingProgress?.total ? <small>{onboardingProgress.done} / {onboardingProgress.total}</small> : null}</h2>
+                    {onboardingProgress?.total ? <div className="cw-progress" data-done={onboardingProgress.done === onboardingProgress.total ? "" : undefined} role="progressbar" aria-label="Étapes d’intégration terminées" aria-valuemin={0} aria-valuemax={onboardingProgress.total} aria-valuenow={onboardingProgress.done}>
+                        <span style={{ width: `${Math.round((onboardingProgress.done / onboardingProgress.total) * 100)}%` }} />
+                    </div> : <p className="cw-hint">Du contrat au premier appel.</p>}
+                    <button className="cw-shortcut" onClick={() => setActiveTab("onboarding")}><ListChecks /><span>Ouvrir l’intégration</span><ChevronRight /></button>
+                </section>
+                <section className="cw-rail-section">
+                    <h2 className="cw-rail-title">Raccourcis</h2>
+                    <div className="cw-shortcuts">
+                        <button className="cw-shortcut" onClick={() => setActiveTab("acces")}><Users /><span>Contacts et accès</span><small>{usersList.length + interlocuteurs.length || ""}</small><ChevronRight /></button>
+                        <button className="cw-shortcut" onClick={() => setActiveTab("sessions")}><FileText /><span>Comptes rendus</span><small>{sessions.length || ""}</small><ChevronRight /></button>
+                        <button className="cw-shortcut" onClick={() => setActiveTab("avis-sdr")}><MessageSquare /><span>Avis SDR</span><small>{sdrFeedback.length || ""}</small><ChevronRight /></button>
+                    </div>
+                </section>
+            </aside>
+        </div>
+    );
+}
diff --git a/components/manager/workspace/client/MissionLine.tsx b/components/manager/workspace/client/MissionLine.tsx
new file mode 100644
index 0000000..a3ec968
--- /dev/null
+++ b/components/manager/workspace/client/MissionLine.tsx
@@ -0,0 +1,84 @@
+"use client";
+
+import { Archive, CircleDashed, Crosshair, FileCheck2, FileText, Inbox, MoreHorizontal, PauseCircle, PlayCircle, Rocket, UserCog } from "lucide-react";
+import {
+    DropdownMenu,
+    DropdownMenuContent,
+    DropdownMenuItem,
+    DropdownMenuLabel,
+    DropdownMenuRadioGroup,
+    DropdownMenuRadioItem,
+    DropdownMenuSeparator,
+    DropdownMenuSub,
+    DropdownMenuSubContent,
+    DropdownMenuSubTrigger,
+    DropdownMenuTrigger,
+} from "@/components/ui/shadcn/dropdown-menu";
+import { MISSION_STATUS_CONFIG, MISSION_STATUS_TRANSITIONS, type MissionStatusValue } from "@/lib/constants/missionStatus";
+import type { AttentionEntry } from "@/lib/manager/attention";
+import type { WorkspaceMission } from "@/components/manager/workspace/InboxItem";
+import type { MissionLite } from "@/lib/manager/workspace/client/types";
+import { cn } from "@/lib/utils";
+import { missionPeriod } from "./format";
+
+/** One mission on the client home: name, facts, what needs doing, quick commands. */
+export function MissionLine({
+    mission,
+    summary,
+    attention,
+    onOpen,
+    onStatusChange,
+}: {
+    mission: MissionLite;
+    summary?: WorkspaceMission;
+    attention?: AttentionEntry<WorkspaceMission>;
+    onOpen: (tab?: string) => void;
+    onStatusChange: (next: MissionStatusValue) => void;
+}) {
+    const cfg = MISSION_STATUS_CONFIG[mission.status];
+    const lists = summary?.readiness?.activeLists ?? mission._count?.lists ?? 0;
+    const sdr = summary?.sdrCount ?? mission._count?.sdrAssignments ?? 0;
+    const period = missionPeriod(mission);
+    const facts = [`${lists} base${lists > 1 ? "s" : ""}`, `${sdr} SDR`, period].filter(Boolean).join(" · ");
+    const tone = attention && attention.tone !== "success" ? attention.tone : undefined;
+    const iconTone = attention?.tone === "danger" ? "danger" : attention?.tone === "warning" ? "todo" : attention?.tone === "success" || mission.status === "ACTIVE" ? "done" : "wait";
+    const Icon = mission.status === "ACTIVE" ? PlayCircle : mission.status === "PAUSED" ? PauseCircle : mission.status === "DRAFT" ? FileText : mission.status === "COMPLETED" ? FileCheck2 : Archive;
+
+    return (
+        <div className="cw-row cw-mission-row" data-interactive onClick={() => onOpen()}>
+            <span className="cw-row-icon" data-tone={iconTone}><Icon aria-hidden /></span>
+            <div className="cw-row-main">
+                <button className="cw-row-title" data-focus-key={`mission:${mission.id}`} title={mission.name} onClick={(event) => { event.stopPropagation(); onOpen(); }}>{mission.name}</button>
+                <small title={mission.objective ?? undefined}>{facts}</small>
+            </div>
+            <div className="cw-row-side" onClick={(event) => event.stopPropagation()}>
+                {attention
+                    ? <button className={cn("cw-pill", "cursor-pointer")} data-tone={tone === "danger" ? "danger" : tone === "warning" ? "warning" : attention.tone === "success" ? "success" : undefined} onClick={() => onOpen(attention.tab)} title={`${attention.detail} — ${attention.action}`}>
+                        <i />{attention.label}
+                    </button>
+                    : <span className="cw-pill" data-tone={mission.status === "ACTIVE" ? "success" : mission.status === "PAUSED" ? "warning" : undefined}><i />{cfg?.label ?? mission.status}</span>}
+                <DropdownMenu>
+                    <DropdownMenuTrigger asChild><button className="cw-button cw-quiet cw-icon-button" data-size="sm" aria-label={`Actions : ${mission.name}`}><MoreHorizontal /></button></DropdownMenuTrigger>
+                    <DropdownMenuContent align="end" className="w-60">
+                        <DropdownMenuLabel className="truncate">{mission.name}</DropdownMenuLabel>
+                        <DropdownMenuItem onSelect={() => onOpen("lancement")}><Rocket />Lancement</DropdownMenuItem>
+                        <DropdownMenuItem onSelect={() => onOpen("strategies")}><Crosshair />Ciblage et scripts</DropdownMenuItem>
+                        <DropdownMenuItem onSelect={() => onOpen("audience")}><Inbox />Bases de prospects</DropdownMenuItem>
+                        <DropdownMenuItem onSelect={() => onOpen("equipe")}><UserCog />Équipe</DropdownMenuItem>
+                        <DropdownMenuSeparator />
+                        <DropdownMenuSub>
+                            <DropdownMenuSubTrigger><CircleDashed />Statut : {cfg?.label}</DropdownMenuSubTrigger>
+                            <DropdownMenuSubContent className="w-48">
+                                <DropdownMenuRadioGroup value={mission.status} onValueChange={(value) => onStatusChange(value as MissionStatusValue)}>
+                                    {[mission.status, ...(MISSION_STATUS_TRANSITIONS[mission.status] ?? [])].map((status) => (
+                                        <DropdownMenuRadioItem key={status} value={status} disabled={status === mission.status}>{MISSION_STATUS_CONFIG[status].label}</DropdownMenuRadioItem>
+                                    ))}
+                                </DropdownMenuRadioGroup>
+                            </DropdownMenuSubContent>
+                        </DropdownMenuSub>
+                    </DropdownMenuContent>
+                </DropdownMenu>
+            </div>
+        </div>
+    );
+}
diff --git a/components/manager/workspace/client/PageTemplateItems.tsx b/components/manager/workspace/client/PageTemplateItems.tsx
new file mode 100644
index 0000000..fe16d1e
--- /dev/null
+++ b/components/manager/workspace/client/PageTemplateItems.tsx
@@ -0,0 +1,20 @@
+"use client";
+
+import { FileText } from "lucide-react";
+import { DropdownMenuItem } from "@/components/ui/shadcn/dropdown-menu";
+import { PAGE_TEMPLATES, PAGE_TEMPLATE_IDS, type PageTemplate } from "@/lib/client-pages/blocks";
+
+/** « Nouvelle page » menu entries, one per template. */
+export function PageTemplateItems({ disabled, onPick }: { disabled?: boolean; onPick: (template: PageTemplate) => void }) {
+    return <>
+        {PAGE_TEMPLATE_IDS.map((id) => (
+            <DropdownMenuItem key={id} disabled={disabled} onSelect={() => onPick(id)}><FileText />{PAGE_TEMPLATES[id].label}</DropdownMenuItem>
+        ))}
+    </>;
+}
+
+/** Page creation as the shell exposes it to its views. */
+export interface PageCreation {
+    pending: boolean;
+    create: (template: PageTemplate, missionId?: string | null) => void;
+}
diff --git a/components/manager/workspace/client/cards.tsx b/components/manager/workspace/client/cards.tsx
new file mode 100644
index 0000000..e59acf1
--- /dev/null
+++ b/components/manager/workspace/client/cards.tsx
@@ -0,0 +1,86 @@
+"use client";
+
+// Card primitives of the client views that have not moved to the document
+// language yet (Phase 4 restyles them). Kept as they were in ClientDrawer.tsx.
+
+import type { ReactNode } from "react";
+
+/** Title + optional action + body (reference image style). */
+export function SectionCard({
+    title,
+    icon,
+    action,
+    children,
+    muted,
+}: {
+    title: string;
+    icon?: ReactNode;
+    action?: ReactNode;
+    children: ReactNode;
+    muted?: boolean;
+}) {
+    return (
+        <div
+            className={
+                "rounded-2xl border border-slate-200/80 " +
+                (muted ? "bg-slate-50/50" : "bg-white")
+            }
+        >
+            <div className="flex items-center justify-between px-5 py-3.5 border-b border-slate-100">
+                <div className="flex items-center gap-2.5">
+                    {icon && (
+                        <div className="w-7 h-7 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center">
+                            {icon}
+                        </div>
+                    )}
+                    <h3 className="text-sm font-bold text-slate-900 tracking-tight">{title}</h3>
+                </div>
+                {action}
+            </div>
+            <div className="p-5">{children}</div>
+        </div>
+    );
+}
+
+/** One figure with icon and label (activity header). */
+export function StatPill({
+    icon,
+    value,
+    label,
+    tone = "indigo",
+}: {
+    icon: ReactNode;
+    value: ReactNode;
+    label: string;
+    tone?: "indigo" | "emerald" | "amber" | "slate";
+}) {
+    const tones: Record<string, string> = {
+        indigo: "bg-primary-50 text-primary-600 border-primary-100",
+        emerald: "bg-emerald-50 text-emerald-600 border-emerald-100",
+        amber: "bg-amber-50 text-amber-600 border-amber-100",
+        slate: "bg-slate-50 text-slate-600 border-slate-100",
+    };
+    return (
+        <div className="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-white border border-slate-200">
+            <div className={`w-9 h-9 rounded-lg border flex items-center justify-center ${tones[tone]}`}>
+                {icon}
+            </div>
+            <div>
+                <div className="text-base font-bold text-slate-900 leading-none">{value}</div>
+                <div className="text-[10px] font-semibold text-slate-500 uppercase tracking-wider mt-1">
+                    {label}
+                </div>
+            </div>
+        </div>
+    );
+}
+
+/** Dashed empty block with an icon. */
+export function DashedEmpty({ icon, title }: { icon: ReactNode; title: string }) {
+    return (
+        <div className="rounded-2xl border border-dashed border-slate-200 bg-slate-50/50 p-10 text-center">
+            {icon}
+            <p className="text-sm font-medium text-slate-700">{title}</p>
+        </div>
+    );
+}
