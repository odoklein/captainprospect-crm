--- /dev/null
+++ b/components/manager/workspace/client/format.ts
@@ -0,0 +1,56 @@
+// Display helpers of the client workspace (French formats).
+
+const shortDate = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "short", timeZone: "Europe/Paris" });
+
+export function draftCount(missions: { status: string }[]) {
+    return missions.filter((mission) => mission.status === "DRAFT").length;
+}
+
+export function missionPeriod(mission: { startDate?: string | null; endDate?: string | null }) {
+    if (!mission.startDate && !mission.endDate) return null;
+    const start = mission.startDate ? shortDate.format(new Date(mission.startDate)) : "…";
+    const end = mission.endDate ? shortDate.format(new Date(mission.endDate)) : "…";
+    return `${start} – ${end}`;
+}
+
+export function formatDate(d?: string | null) {
+    if (!d) return "—";
+    return new Date(d).toLocaleDateString("fr-FR", {
+        year: "numeric",
+        month: "short",
+        day: "numeric",
+    });
+}
+
+export function formatRelative(d?: string | null) {
+    if (!d) return "Jamais";
+    const diff = Date.now() - new Date(d).getTime();
+    const min = Math.floor(diff / 60000);
+    if (min < 1) return "À l’instant";
+    if (min < 60) return `Il y a ${min} min`;
+    const hours = Math.floor(min / 60);
+    if (hours < 24) return `Il y a ${hours}h`;
+    const days = Math.floor(hours / 24);
+    if (days < 30) return `Il y a ${days}j`;
+    return formatDate(d);
+}
+
+export function formatMonth(month?: string) {
+    if (!month) return "Mois en cours";
+    const [year, monthNumber] = month.split("-").map(Number);
+    return new Date(year, monthNumber - 1, 1).toLocaleDateString("fr-FR", {
+        month: "long",
+        year: "numeric",
+    });
+}
+
+export function toNumber(v: number | string | null | undefined): number | null {
+    if (v === null || v === undefined || v === "") return null;
+    const n = Number(v);
+    return Number.isNaN(n) ? null : n;
+}
+
+export function formatEuro(v: number | string | null | undefined): string {
+    const n = toNumber(v);
+    return n === null ? "—" : `${n.toLocaleString("fr-FR")} €`;
+}
diff --git a/components/manager/workspace/client/model.ts b/components/manager/workspace/client/model.ts
