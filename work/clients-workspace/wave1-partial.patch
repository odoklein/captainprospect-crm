@@ -0,0 +1,141 @@
+"use client";
+
+// React Query reads for the mission workspace.
+//
+// Phase 2 keeps every view on the full GET /api/missions/[id] (key « brief »):
+// lists, strategies and team are `select`s of it, so a panel reads only its
+// slice and re-renders only when that slice changes. Their own keys are
+// reserved below; Phase 3 moves them to ?view=brief + dedicated reads.
+
+import { useQuery } from "@tanstack/react-query";
+import {
+    fetchAssignableUsers,
+    fetchCampaignStrategy,
+    fetchMailboxes,
+    fetchMission,
+    fetchMissionFeedback,
+    fetchMissionInsights,
+    fetchMissionTemplates,
+    fetchSharedTemplates,
+} from "./api";
+import type { FeedbackRange, InsightsPeriod, Mission } from "./types";
+
+export const missionKeys = {
+    all: (missionId: string) => ["mission", missionId] as const,
+    brief: (missionId: string) => ["mission", missionId, "brief"] as const,
+    lists: (missionId: string) => ["mission", missionId, "lists"] as const,
+    strategies: (missionId: string) => ["mission", missionId, "strategies"] as const,
+    /** Campaign + script companion of one strategy (prefix of strategies). */
+    strategy: (missionId: string, campaignId: string) => ["mission", missionId, "strategies", campaignId] as const,
+    templates: (missionId: string) => ["mission", missionId, "templates"] as const,
+    sharedTemplates: (missionId: string) => ["mission", missionId, "templates", "shared"] as const,
+    team: (missionId: string) => ["mission", missionId, "team"] as const,
+    assignableUsers: (missionId: string) => ["mission", missionId, "team", "assignable"] as const,
+    feedback: (missionId: string, range: FeedbackRange) => ["mission", missionId, "feedback", range] as const,
+    insights: (missionId: string, period: InsightsPeriod) => ["mission", missionId, "insights", period] as const,
+};
+
+/** Mailboxes are per user, not per mission. */
+export const MISSION_MAILBOXES_KEY = ["manager", "workspace", "mailboxes"] as const;
+
+/**
+ * One attempt and no focus refetch: the workspace loaded its data once and
+ * reloaded it after its own writes (a failed mission load sends the user back).
+ */
+const once = { retry: false, refetchOnWindowFocus: false } as const;
+
+const briefOptions = (missionId: string) => ({
+    queryKey: missionKeys.brief(missionId),
+    queryFn: () => fetchMission(missionId),
+    ...once,
+});
+
+export function useMissionBrief(missionId: string) {
+    return useQuery(briefOptions(missionId));
+}
+
+const selectLists = (mission: Mission) => mission.lists;
+const selectStrategies = (mission: Mission) => mission.campaigns;
+const selectTeam = (mission: Mission) => ({
+    assignments: mission.sdrAssignments,
+    teamLeadSdrId: mission.teamLeadSdrId ?? null,
+    teamStats: mission.teamStats ?? [],
+});
+
+export function useMissionLists(missionId: string) {
+    return useQuery({ ...briefOptions(missionId), select: selectLists });
+}
+
+export function useMissionStrategies(missionId: string) {
+    return useQuery({ ...briefOptions(missionId), select: selectStrategies });
+}
+
+export function useMissionTeam(missionId: string) {
+    return useQuery({ ...briefOptions(missionId), select: selectTeam });
+}
+
+export function useMissionInsights(missionId: string, period: InsightsPeriod, enabled = true) {
+    return useQuery({
+        queryKey: missionKeys.insights(missionId, period),
+        queryFn: () => fetchMissionInsights(missionId, period),
+        enabled,
+    });
+}
+
+export function useMissionFeedback(missionId: string, range: FeedbackRange) {
+    return useQuery({
+        queryKey: missionKeys.feedback(missionId, range),
+        queryFn: () => fetchMissionFeedback(missionId, range),
+        // The panel reloads every time it opens, like the old tab did.
+        staleTime: 0,
+        ...once,
+    });
+}
+
+export function useAssignableUsers(missionId: string, enabled: boolean) {
+    return useQuery({
+        queryKey: missionKeys.assignableUsers(missionId),
+        queryFn: fetchAssignableUsers,
+        enabled,
+        staleTime: Infinity,
+        ...once,
+    });
+}
+
+export function useMissionMailboxes(enabled = true) {
+    return useQuery({
+        queryKey: MISSION_MAILBOXES_KEY,
+        queryFn: fetchMailboxes,
+        enabled,
+        staleTime: 0,
+        ...once,
+    });
+}
+
+export function useCampaignStrategy(missionId: string, campaignId: string | null | undefined) {
+    return useQuery({
+        queryKey: missionKeys.strategy(missionId, campaignId ?? ""),
+        queryFn: () => fetchCampaignStrategy(campaignId as string),
+        enabled: Boolean(campaignId),
+        ...once,
+    });
+}
+
+export function useMissionTemplates(missionId: string) {
+    return useQuery({
+        queryKey: missionKeys.templates(missionId),
+        queryFn: () => fetchMissionTemplates(missionId),
+        ...once,
+    });
+}
+
+/** Shared templates for « Existant »: read afresh each time the dialog opens. */
+export function useSharedTemplates(missionId: string, enabled: boolean) {
+    return useQuery({
+        queryKey: missionKeys.sharedTemplates(missionId),
+        queryFn: fetchSharedTemplates,
+        enabled,
+        staleTime: 0,
+        ...once,
+    });
+}
diff --git a/lib/manager/workspace/mission/types.ts b/lib/manager/workspace/mission/types.ts
