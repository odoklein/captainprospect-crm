@@ -0,0 +1,251 @@
+// Response shapes of the mission workspace (manager « Espace clients »).
+// One Mission type for the whole workspace instead of a partial per file.
+// Sources: GET /api/missions/[id], /api/missions/[id]/insights,
+// /api/missions/[id]/templates, /api/campaigns/[id](/script-companion),
+// /api/manager/sdr-feedback, /api/users, /api/email/mailboxes.
+
+import type { PulseData } from "@/components/missions/MissionPulse";
+import type { DailyReportLike } from "@/components/sdr/DailyReportView";
+import type { MissionStatusValue } from "@/lib/constants/missionStatus";
+
+export type MissionChannel = "CALL" | "EMAIL" | "LINKEDIN";
+
+export interface PersonRef {
+    id: string;
+    firstName: string;
+    lastName: string;
+    title?: string | null;
+}
+
+export interface MissionListReadiness {
+    inheritedCampaignId?: string | null;
+    hasStrategy: boolean;
+    hasIcp: boolean;
+    hasPitch: boolean;
+    hasScript: boolean;
+    isReady: boolean;
+}
+
+export interface MissionList {
+    id: string;
+    name: string;
+    type: string;
+    isActive?: boolean;
+    isArchived?: boolean;
+    contactsViewEnabled?: boolean;
+    /** 24 h pause between two calls on this list's rows — on unless a manager switched it off. */
+    queueCooldownEnabled?: boolean;
+    commercialInterlocuteurId?: string | null;
+    secondaryCommercialIds?: string[];
+    commercialInterlocuteur?: PersonRef | null;
+    /** Counted in SQL by the API (no per-company rows any more). */
+    _count?: { companies: number; contacts?: number };
+    /** Companies per status, counted in SQL. */
+    companyStatusCounts?: Record<string, number>;
+    campaignId?: string | null;
+    campaign?: {
+        id: string;
+        name: string;
+        icp: string | null;
+        pitch: string | null;
+        script: string | null;
+        isActive: boolean;
+    } | null;
+    readiness?: MissionListReadiness;
+}
+
+export interface MissionCampaign {
+    id: string;
+    name: string;
+    isActive: boolean;
+}
+
+export interface MissionSdr {
+    id: string;
+    name: string;
+    email: string;
+    role: string;
+    selectedListId?: string | null;
+    selectedMissionId?: string | null;
+}
+
+export interface MissionAssignment {
+    id: string;
+    sdr: MissionSdr;
+}
+
+export interface MissionTeamStat {
+    sdrId: string;
+    name?: string;
+    actions: number;
+    meetings: number;
+    recentActions: number;
+}
+
+export interface MissionSeriesPoint {
+    date: string;
+    actions: number;
+    meetings: number;
+    reached?: number;
+}
+
+export interface MissionTotals {
+    actions: number;
+    meetings: number;
+    opportunities: number;
+}
+
+export interface Mission {
+    id: string;
+    name: string;
+    objective?: string;
+    channel: MissionChannel;
+    channels?: MissionChannel[];
+    status: MissionStatusValue;
+    isActive: boolean;
+    portalLaunchStartedAt?: string | null;
+    portalVisibleAt?: string | null;
+    startDate?: string;
+    endDate?: string;
+    client?: {
+        id: string;
+        name: string;
+        interlocuteurs?: (PersonRef & { isActive: boolean })[];
+    };
+    teamLeadSdrId?: string | null;
+    teamLeadSdr?: { id: string; name: string; email: string } | null;
+    sdrAssignments: MissionAssignment[];
+    campaigns: MissionCampaign[];
+    lists: MissionList[];
+    missionReadiness?: {
+        activeLists: number;
+        readyLists: number;
+        missingStrategy: number;
+        missingIcp: number;
+        missingPitch: number;
+        missingScript: number;
+    };
+    _count: {
+        sdrAssignments: number;
+        campaigns: number;
+        lists: number;
+    };
+    stats?: {
+        totalActions: number;
+        meetingsBooked: number;
+        opportunities: number;
+    };
+    targetMeetings?: number | null;
+    /** Absent with ?view=brief. */
+    pulse?: PulseData;
+    /** Absent with ?view=brief. */
+    teamStats?: MissionTeamStat[];
+    /** Absent with ?view=brief. */
+    insights?: {
+        windowDays: number;
+        series: MissionSeriesPoint[];
+        current: MissionTotals;
+        previous: MissionTotals;
+    };
+    defaultMailboxId?: string | null;
+    defaultInterlocuteur?: PersonRef | null;
+}
+
+export type InsightsPeriod = "7" | "30" | "90" | "all";
+
+/** GET /api/missions/[id]/insights?period= (Phase 3 period selector). */
+export interface MissionInsights {
+    period: InsightsPeriod;
+    windowDays: number;
+    windowStart: string;
+    series: MissionSeriesPoint[];
+    current: MissionTotals;
+    previous: MissionTotals | null;
+    pulse: PulseData & { periodFunnel: PulseData["funnel"] };
+    teamStats: MissionTeamStat[];
+    lists: Array<{
+        listId: string;
+        name: string;
+        called: number;
+        reached: number;
+        meetings: number;
+        companies: number;
+        contacts: number;
+        workedCompanies: number;
+    }>;
+}
+
+export interface AssignableUser {
+    id: string;
+    name: string;
+    email: string;
+    role: string;
+}
+
+export interface EmailTemplate {
+    id: string;
+    name: string;
+    subject: string;
+    bodyHtml: string;
+    category: string;
+    variables: string[];
+    createdBy?: { id: string; name: string };
+}
+
+export interface MissionTemplate {
+    id: string;
+    order: number;
+    template: EmailTemplate;
+}
+
+export interface TemplateFields {
+    name: string;
+    subject: string;
+    bodyHtml: string;
+    category: string;
+}
+
+export interface CampaignData {
+    id: string;
+    name: string;
+    icp: string;
+    pitch: string;
+    script?: string | null;
+    rules?: Record<string, unknown> | null;
+    isActive: boolean;
+}
+
+export type ScriptTab = "base" | "additional" | "ai";
+
+/** GET /api/campaigns/[id]/script-companion, normalised (missing → empty). */
+export interface ScriptCompanion {
+    additionalDraft: string;
+    additionalShared: string;
+    aiDraft: string;
+    aiShared: string;
+    aiGeneratedAt: string | null;
+    defaultTab: ScriptTab;
+}
+
+export interface CampaignStrategy {
+    campaign: CampaignData;
+    companion: ScriptCompanion;
+}
+
+export interface MissionFeedbackItem extends DailyReportLike {
+    id: string;
+    submittedAt: string;
+    sdr: { id: string; name: string; email: string };
+    missions: Array<{ mission: { id: string; name: string } }>;
+}
+
+export interface FeedbackRange {
+    from: string;
+    to: string;
+}
+
+export interface Mailbox {
+    id: string;
+    email: string;
+    displayName: string | null;
+}
