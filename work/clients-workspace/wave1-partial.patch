+// Response shapes of the client workspace (/manager/clients?client=…).
+// One declaration per shape (plan finding S7): views import from here instead
+// of redeclaring partial copies.
+
+import type { MissionStatusValue } from "@/lib/constants/missionStatus";
+import type { DailyReportLike } from "@/components/sdr/DailyReportView";
+
+export type ClientStatus = "ACTIVE" | "PAUSED" | "STOPPED";
+
+/** The client row the workspace is opened with (directory row, kept in the parent's cache). */
+export interface Client {
+    id: string;
+    name: string;
+    industry?: string;
+    email?: string;
+    phone?: string;
+    status?: ClientStatus;
+    createdAt: string;
+    bookingUrl?: string;
+    _count: {
+        missions: number;
+        users: number;
+    };
+    portalShowCallHistory?: boolean;
+    portalShowDatabase?: boolean;
+    rdvEmailNotificationsEnabled?: boolean;
+}
+
+export interface MissionPlanLite {
+    id: string;
+    frequency: number;
+    preferredDays: string[];
+    timePreference?: string | null;
+    customStartTime?: string | null;
+    customEndTime?: string | null;
+    startDate?: string;
+    endDate?: string | null;
+}
+
+export interface MissionLite {
+    id: string;
+    name: string;
+    objective?: string | null;
+    status: MissionStatusValue;
+    createdAt?: string;
+    startDate?: string | null;
+    endDate?: string | null;
+    channel?: string | null;
+    _count?: { campaigns?: number; lists?: number; sdrAssignments?: number };
+    campaigns?: Array<{ id: string; name: string; icp?: string | null }>;
+    lists?: Array<{ id: string; name: string; type?: string; _count?: { companies?: number } }>;
+    missionPlans?: MissionPlanLite[];
+}
+
+export interface ClientUserLite {
+    id: string;
+    name: string | null;
+    email: string;
+    role: string;
+    isActive: boolean;
+    lastSignInAt: string | null;
+    lastConnectedAt: string | null;
+    createdAt: string;
+}
+
+export interface InterlocuteurLite {
+    id: string;
+    firstName: string;
+    lastName: string;
+    email?: string | null;
+    phone?: string | null;
+    jobTitle?: string | null;
+    title?: string | null;
+    emails?: Array<{ value: string; isPrimary: boolean }>;
+    phones?: Array<{ value: string; isPrimary: boolean }>;
+    createdAt: string;
+    portalUser?: { id: string; email: string; name: string | null; isActive: boolean } | null;
+}
+
+export interface ClientProductionInsights {
+    month: string;
+    firstCallAt?: string | null;
+    plannedMonthDays: number | null;
+    plannedWeekDays: number | null;
+    plannedMonthDaysFromWeekly?: number | null;
+    hasMonthlyPlan?: boolean;
+    executedDays: number;
+    workedCallDays?: number;
+    totalWorkedCallDays?: number;
+    totalActions: number;
+    totalCalls: number;
+    totalMeetings: number;
+}
+
+export type EngagementStatut = "BROUILLON" | "ACTIF" | "EXPIRE" | "RENOUVELE" | "RESILIE" | "ARCHIVE";
+
+export interface ClientEngagementInsights {
+    id: string;
+    offreTarifId: string;
+    dureeMois: number;
+    debut: string;
+    fin: string;
+    statut: EngagementStatut;
+    renouvellement?: string | null;
+    penaliteResiliation?: string | null;
+    fixeOverride?: number | string | null;
+    rdvOverride?: number | string | null;
+    offreTarif: { id: string; nom: string; fixeMensuel: number | string; prixParRdv: number | string };
+}
+
+export interface ClientActionInsight {
+    id: string;
+    createdAt: string;
+    callbackDate?: string | null;
+    result: string;
+    channel: string;
+    note?: string | null;
+    duration?: number | null;
+    sdr: { id: string; name: string | null };
+    company?: { id: string; name: string } | null;
+    contact?: {
+        id: string;
+        firstName?: string | null;
+        lastName?: string | null;
+        title?: string | null;
+        company?: { id: string; name: string } | null;
+    } | null;
+    campaign: {
+        id: string;
+        name: string;
+        mission: { id: string; name: string };
+    };
+}
+
+export interface ClientSdrFeedbackInsight extends DailyReportLike {
+    id: string;
+    submittedAt: string;
+    sdr: { id: string; name: string | null; email: string };
+    mission?: { id: string; name: string } | null;
+    missions: Array<{ mission: { id: string; name: string } }>;
+}
+
+export interface ClientOnboardingData {
+    defaultMailboxId?: string;
+    icp?: string;
+    portalAllowExport?: boolean;
+}
+
+/** GET /api/clients/:id — the fields the workspace reads. */
+export interface ClientDetail {
+    id: string;
+    name: string;
+    email?: string | null;
+    status?: ClientStatus;
+    bookingUrl?: string | null;
+    missions?: MissionLite[];
+    users?: ClientUserLite[];
+    interlocuteurs?: InterlocuteurLite[];
+    insights?: {
+        production?: ClientProductionInsights;
+        engagement?: ClientEngagementInsights | null;
+        recentActions?: ClientActionInsight[];
+        sdrFeedback?: ClientSdrFeedbackInsight[];
+    };
+    onboarding?: { onboardingData?: ClientOnboardingData | null } | null;
+    [key: string]: unknown;
+}
+
+export interface Mailbox {
+    id: string;
+    email: string;
+    displayName: string | null;
+}
+
+export interface BillingOffer {
+    id: string;
+    nom: string;
+    fixeMensuel: number;
+    prixParRdv: number;
+}
+
+// ── Sessions & comptes rendus ───────────────────────────────────────────────
+
+export type SessionType = "Kick-Off" | "Onboarding" | "Validation" | "Reporting" | "Suivi" | "Autre";
+export const SESSION_TYPES: SessionType[] = ["Kick-Off", "Onboarding", "Validation", "Reporting", "Suivi", "Autre"];
+
+export interface SessionTask {
+    id: string;
+    label: string;
+    assignee?: string | null;
+    assigneeRole?: "SDR" | "MANAGER" | "DEV" | "ALWAYS" | null;
+    priority?: "LOW" | "MEDIUM" | "HIGH" | "URGENT" | null;
+    dueDate?: string | null;
+    doneAt?: string | null;
+    taskId?: string | null;
+}
+
+export interface ClientSession {
+    id: string;
+    type: SessionType;
+    customTypeLabel?: string | null;
+    date: string;
+    leexiId?: string | null;
+    recordingUrl?: string | null;
+    crMarkdown?: string | null;
+    summaryEmail?: string | null;
+    emailSentAt?: string | null;
+    projectId?: string | null;
+    tasks: SessionTask[];
+    createdAt: string;
+}
+
+export interface LeexiTranscription {
+    id: string;
+    title: string;
+    date: string;
+    duration: number;
+    participants: string[];
+    transcript?: string;
+    recordingUrl?: string;
+}
+
+/** Task as sent to the sessions API (from AITaskExtractor). */
+export interface SessionTaskInput {
+    label: string;
+    assignee?: string;
+    assigneeId?: string;
+    assigneeRole?: string;
+    priority?: string;
+    dueDate?: string;
+}
+
+export interface CreateSessionInput {
+    type: SessionType;
+    leexiId: string;
+    crMarkdown: string;
+    summaryEmail: string;
+    notifyByEmail: boolean;
+    recordingUrl?: string;
+    date: string;
+    customTypeLabel?: string;
+    tasks: SessionTaskInput[];
+}
+
+export interface UpdateSessionInput {
+    type: SessionType;
+    date: string;
+    crMarkdown?: string | null;
+    summaryEmail?: string | null;
+    tasks?: SessionTaskInput[];
+}
diff --git a/lib/manager/workspace/directory/aggregates.ts b/lib/manager/workspace/directory/aggregates.ts
new file mode 100644
index 0000000..56f8a25
--- /dev/null
+++ b/lib/manager/workspace/directory/aggregates.ts
@@ -0,0 +1,258 @@
+// Server side of the clients directory (GET /api/clients?view=workspace):
+// every per-mission and per-client figure in a handful of grouped SQL
+// queries, whatever the portfolio size. No campaign text leaves the database:
+// readiness only needs "is there an ICP / pitch / script", computed in SQL.
+//
+// `db` only needs $queryRaw so the SQL runs for real on PGlite in
+// aggregates.pglite.test.ts.
+
+import { Prisma } from "@prisma/client";
+import { DateTime } from "luxon";
+import { computeListReadiness, defaultCampaignOf, openPoints, summarizeReadiness, type ReadinessCampaign } from "@/lib/missions/readiness";
+import { ONBOARDING_LABEL } from "@/lib/onboarding/checklist-template";
+import { reminderDateRange } from "@/lib/meetings/feedbackReminder";
+import { NO_SHOW_REPORT_WINDOW_MS } from "@/lib/meetings/noShowWindow";
+import { parisDay, parisMidnight } from "@/lib/manager-home/today-rules";
+import { worstPace } from "./sort";
+import type { DirectoryClient, DirectoryClientStatus, DirectoryMission } from "./types";
+
+export interface RawDb {
+    $queryRaw<T = unknown>(query: Prisma.Sql): PromiseLike<T>;
+}
+
+/** What Prisma loads for each client before aggregation (no relation rows beyond missions). */
+export interface BaseMissionRow {
+    id: string;
+    name: string;
+    startDate: Date | string | null;
+    endDate: Date | string | null;
+    status: string;
+    isActive: boolean;
+    channels: string[];
+    targetMeetings: number | null;
+    _count: { sdrAssignments: number };
+}
+
+export interface BaseClientRow {
+    id: string;
+    name: string;
+    industry: string | null;
+    email: string | null;
+    phone: string | null;
+    status: string;
+    createdAt: Date | string;
+    bookingUrl: string | null;
+    _count: { missions: number; users: number };
+    missions: BaseMissionRow[];
+}
+
+type CampaignFlags = { id: string; missionId: string; name: string; isActive: boolean; hasIcp: boolean; hasPitch: boolean; hasScript: boolean };
+type ListRow = { missionId: string; isActive: boolean; isArchived: boolean; campaignId: string | null };
+type MissionActivity = { missionId: string; meetings: number; meetingsThisMonth: number; meetingsLastMonth: number; lastActionAt: unknown; lastCallAt: unknown };
+type EngagementRow = { clientId: string; fin: unknown };
+type OverdueRow = { clientId: string; count: number; oldestDue: unknown; title: string };
+type FeedbackRow = { clientId: string; count: number; urgent: number };
+
+function iso(value: unknown): string | null {
+    if (value === null || value === undefined) return null;
+    const date = value instanceof Date ? value : new Date(String(value).replace(" ", "T") + (/[zZ]|[+-]\d\d:?\d\d$/.test(String(value)) ? "" : "Z"));
+    return Number.isNaN(date.getTime()) ? null : date.toISOString();
+}
+
+const num = (value: unknown) => (typeof value === "bigint" ? Number(value) : Number(value ?? 0));
+
+/** Paris calendar months: [lastMonthStart, thisMonthStart) and [thisMonthStart, …). */
+export function monthWindows(now: Date) {
+    const paris = DateTime.fromJSDate(now).setZone("Europe/Paris").startOf("month");
+    return { thisMonthStart: paris.toUTC().toJSDate(), lastMonthStart: paris.minus({ months: 1 }).toUTC().toJSDate() };
+}
+
+/** Readiness flags of the campaigns of these missions, plus any campaign their lists point to. */
+function campaignFlags(db: RawDb, missionIds: string[]) {
+    return db.$queryRaw<CampaignFlags[]>(Prisma.sql`
+        SELECT c.id, c."missionId" AS "missionId", c.name, c."isActive" AS "isActive",
+               COALESCE(c.icp ~ '[^[:space:]]', false) AS "hasIcp",
+               COALESCE(c.pitch ~ '[^[:space:]]', false) AS "hasPitch",
+               COALESCE(c.script ~ '[^[:space:]]', false) AS "hasScript"
+        FROM "Campaign" c
+        WHERE c."missionId" IN (${Prisma.join(missionIds)})
+           OR c.id IN (SELECT l."campaignId" FROM "List" l WHERE l."missionId" IN (${Prisma.join(missionIds)}) AND l."campaignId" IS NOT NULL)
+        ORDER BY c."createdAt" ASC, c.id ASC
+    `);
+}
+
+function listRows(db: RawDb, missionIds: string[]) {
+    return db.$queryRaw<ListRow[]>(Prisma.sql`
+        SELECT l."missionId" AS "missionId", l."isActive" AS "isActive", l."isArchived" AS "isArchived", l."campaignId" AS "campaignId"
+        FROM "List" l
+        WHERE l."missionId" IN (${Prisma.join(missionIds)}) AND l."isArchived" = false
+    `);
+}
+
+/**
+ * Per mission: meetings over the whole mission (distinct prospects, as the
+ * pulse counts them), MEETING_BOOKED actions this and last Paris month (as
+ * lib/client-insights counts « RDV ce mois »), last action and last call.
+ */
+function missionActivity(db: RawDb, missionIds: string[], now: Date) {
+    const { thisMonthStart, lastMonthStart } = monthWindows(now);
+    return db.$queryRaw<MissionActivity[]>(Prisma.sql`
+        SELECT c."missionId" AS "missionId",
+               COUNT(DISTINCT COALESCE(a."contactId", a."companyId")) FILTER (WHERE a."result"::text = 'MEETING_BOOKED')::int AS meetings,
+               COUNT(*) FILTER (WHERE a."result"::text = 'MEETING_BOOKED' AND a."createdAt" >= ${thisMonthStart})::int AS "meetingsThisMonth",
+               COUNT(*) FILTER (WHERE a."result"::text = 'MEETING_BOOKED' AND a."createdAt" >= ${lastMonthStart} AND a."createdAt" < ${thisMonthStart})::int AS "meetingsLastMonth",
+               MAX(a."createdAt") AS "lastActionAt",
+               MAX(a."createdAt") FILTER (WHERE a."channel"::text = 'CALL') AS "lastCallAt"
+        FROM "Action" a
+        JOIN "Campaign" c ON c.id = a."campaignId"
+        WHERE c."missionId" IN (${Prisma.join(missionIds)})
+        GROUP BY c."missionId"
+    `);
+}
+
+/** End of the current engagement: the latest-ending ACTIF one. */
+function engagementEnds(db: RawDb, clientIds: string[]) {
+    return db.$queryRaw<EngagementRow[]>(Prisma.sql`
+        SELECT DISTINCT ON (e."clientId") e."clientId" AS "clientId", e.fin
+        FROM "Engagement" e
+        WHERE e."clientId" IN (${Prisma.join(clientIds)}) AND e.statut::text = 'ACTIF'
+        ORDER BY e."clientId", e.fin DESC
+    `);
+}
+
+/** Onboarding checklist steps (lib/onboarding) not done whose Paris due day is before today. */
+function onboardingOverdue(db: RawDb, clientIds: string[], now: Date) {
+    const todayStart = parisMidnight(parisDay(now));
+    return db.$queryRaw<OverdueRow[]>(Prisma.sql`
+        SELECT p."clientId" AS "clientId", COUNT(*)::int AS count, MIN(t."dueDate") AS "oldestDue",
+               (ARRAY_AGG(t.title ORDER BY t."dueDate" ASC, t.position ASC))[1] AS title
+        FROM "Task" t
+        JOIN "Project" p ON p.id = t."projectId"
+        WHERE p."clientId" IN (${Prisma.join(clientIds)})
+          AND ${ONBOARDING_LABEL} = ANY(t.labels)
+          AND t."parentTaskId" IS NOT NULL
+          AND t.status::text <> 'DONE'
+          AND t."dueDate" < ${todayStart}
+        GROUP BY p."clientId"
+    `);
+}
+
+/**
+ * Confirmed RDVs that took place in the reminder window and still have no
+ * « Mon avis » — the portal's feedback-pending rule (lib/meetings/feedbackReminder),
+ * on missions already visible in the portal. `urgent`: no-show window still open.
+ */
+function feedbackPending(db: RawDb, clientIds: string[], now: Date) {
+    const { from, to } = reminderDateRange(now.getTime());
+    const windowStart = new Date(now.getTime() - NO_SHOW_REPORT_WINDOW_MS);
+    return db.$queryRaw<FeedbackRow[]>(Prisma.sql`
+        SELECT m."clientId" AS "clientId", COUNT(*)::int AS count,
+               COUNT(*) FILTER (WHERE a."callbackDate" >= ${windowStart})::int AS urgent
+        FROM "Action" a
+        JOIN "Campaign" c ON c.id = a."campaignId"
+        JOIN "Mission" m ON m.id = c."missionId"
+        LEFT JOIN "MeetingFeedback" f ON f."actionId" = a.id
+        WHERE m."clientId" IN (${Prisma.join(clientIds)})
+          AND a."result"::text = 'MEETING_BOOKED'
+          AND a."confirmationStatus"::text = 'CONFIRMED'
+          AND a."callbackDate" >= ${from} AND a."callbackDate" <= ${to}
+          AND f.id IS NULL
+          AND (m."portalVisibleAt" IS NULL OR m."portalVisibleAt" <= ${now})
+        GROUP BY m."clientId"
+    `);
+}
+
+/** Base rows → directory clients with readiness, activity, metrics and attention signals. */
+export async function buildDirectoryClients(db: RawDb, clients: BaseClientRow[], now = new Date()): Promise<DirectoryClient[]> {
+    const clientIds = clients.map((client) => client.id);
+    const missionIds = clients.flatMap((client) => client.missions.map((mission) => mission.id));
+    const none = <T,>() => Promise.resolve([] as T[]);
+    const [campaigns, lists, activity, engagements, overdue, feedback] = await Promise.all([
+        missionIds.length ? campaignFlags(db, missionIds) : none<CampaignFlags>(),
+        missionIds.length ? listRows(db, missionIds) : none<ListRow>(),
+        missionIds.length ? missionActivity(db, missionIds, now) : none<MissionActivity>(),
+        clientIds.length ? engagementEnds(db, clientIds) : none<EngagementRow>(),
+        clientIds.length ? onboardingOverdue(db, clientIds, now) : none<OverdueRow>(),
+        clientIds.length ? feedbackPending(db, clientIds, now) : none<FeedbackRow>(),
+    ]);
+
+    // readiness.ts reads text fields; the flags stand in for them ("x" = filled).
+    const asCampaign = (flags: CampaignFlags): NonNullable<ReadinessCampaign> => ({
+        id: flags.id,
+        name: flags.name,
+        isActive: flags.isActive,
+        icp: flags.hasIcp ? "x" : null,
+        pitch: flags.hasPitch ? "x" : null,
+        script: flags.hasScript ? "x" : null,
+    });
+    const campaignById = new Map(campaigns.map((row) => [row.id, asCampaign(row)]));
+    const campaignsByMission = new Map<string, NonNullable<ReadinessCampaign>[]>();
+    for (const row of campaigns) campaignsByMission.set(row.missionId, [...(campaignsByMission.get(row.missionId) ?? []), campaignById.get(row.id)!]);
+    const listsByMission = new Map<string, ListRow[]>();
+    for (const row of lists) listsByMission.set(row.missionId, [...(listsByMission.get(row.missionId) ?? []), row]);
+    const activityByMission = new Map(activity.map((row) => [row.missionId, row]));
+    const engagementByClient = new Map(engagements.map((row) => [row.clientId, iso(row.fin)]));
+    const overdueByClient = new Map(overdue.map((row) => [row.clientId, row]));
+    const feedbackByClient = new Map(feedback.map((row) => [row.clientId, row]));
+    const nowMs = now.getTime();
+
+    return clients.map((client) => {
+        const missions: DirectoryMission[] = client.missions.map((mission) => {
+            const own = campaignsByMission.get(mission.id) ?? [];
+            const fallback = defaultCampaignOf(own);
+            const readiness = summarizeReadiness((listsByMission.get(mission.id) ?? []).map((list) => ({
+                isActive: list.isActive,
+                isArchived: list.isArchived,
+                readiness: computeListReadiness(list.campaignId ? campaignById.get(list.campaignId) ?? null : null, fallback),
+            })));
+            const act = activityByMission.get(mission.id);
+            return {
+                id: mission.id,
+                name: mission.name,
+                startDate: iso(mission.startDate),
+                endDate: iso(mission.endDate),
+                status: mission.status,
+                isActive: mission.isActive,
+                channels: mission.channels,
+                sdrCount: mission._count.sdrAssignments,
+                readiness,
+                openPoints: openPoints(readiness),
+                targetMeetings: mission.targetMeetings,
+                meetings: num(act?.meetings),
+                lastActionAt: iso(act?.lastActionAt),
+                lastCallAt: iso(act?.lastCallAt),
+            };
+        });
+        const lastCallAt = missions.reduce<string | null>((latest, mission) => (mission.lastCallAt && (!latest || mission.lastCallAt > latest) ? mission.lastCallAt : latest), null);
+        const engagementEnd = engagementByClient.get(client.id) ?? null;
+        const late = overdueByClient.get(client.id);
+        const pending = feedbackByClient.get(client.id);
+        const oldestDue = late ? iso(late.oldestDue) : null;
+        return {
+            id: client.id,
+            name: client.name,
+            industry: client.industry ?? undefined,
+            email: client.email ?? undefined,
+            phone: client.phone ?? undefined,
+            status: client.status as DirectoryClientStatus,
+            createdAt: iso(client.createdAt) ?? String(client.createdAt),
+            bookingUrl: client.bookingUrl,
+            _count: client._count,
+            missions,
+            metrics: {
+                meetingsThisMonth: client.missions.reduce((sum, mission) => sum + num(activityByMission.get(mission.id)?.meetingsThisMonth), 0),
+                meetingsLastMonth: client.missions.reduce((sum, mission) => sum + num(activityByMission.get(mission.id)?.meetingsLastMonth), 0),
+                runningMissions: missions.filter((mission) => mission.status === "ACTIVE").length,
+                totalMissions: client._count.missions,
+                worstPace: worstPace(missions, nowMs),
+                engagementEnd,
+                lastCallAt,
+            },
+            signals: {
+                engagementEnd,
+                onboardingOverdue: late && oldestDue ? { count: num(late.count), oldestDueDay: parisDay(new Date(oldestDue)), title: late.title } : null,
+                feedbackPending: pending ? { count: num(pending.count), urgent: num(pending.urgent) } : null,
+            },
+        };
+    });
+}
diff --git a/lib/manager/workspace/directory/sort.ts b/lib/manager/workspace/directory/sort.ts
new file mode 100644
index 0000000..98e9087
--- /dev/null
+++ b/lib/manager/workspace/directory/sort.ts
@@ -0,0 +1,94 @@
+// Search, status filter and sort of the clients directory. Pure: the route
+// (GET /api/clients?view=workspace) runs it over the whole portfolio before
+// paginating, and the tests pin the order.
+
+import { collectAttention } from "@/lib/manager/attention";
+import { pace, type PaceVerdict } from "@/lib/missions/pulse";
+import type { DirectoryClient, DirectoryMission, DirectoryParams } from "./types";
+
+/** Lowercase, accents removed: « Société » matches « societe ». */
+export function searchText(value: string) {
+    return value.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
+}
+
+export function matchesQuery(client: { name: string; industry?: string | null }, q: string) {
+    const query = searchText(q.trim());
+    return !query || searchText(`${client.name} ${client.industry ?? ""}`).includes(query);
+}
+
+/** Worst first: what a manager must look at before anything else. */
+const PACE_SEVERITY: Record<PaceVerdict, number> = {
+    behind: 0,
+    ended: 1,
+    on_track: 2,
+    early: 3,
+    not_started: 4,
+    ahead: 5,
+    reached: 6,
+    no_target: 7,
+};
+
+export function paceSeverity(verdict: PaceVerdict | null): number {
+    return verdict ? PACE_SEVERITY[verdict] : 99;
+}
+
+/** Worst pace() verdict among the ACTIVE missions; null without one. */
+export function worstPace(missions: Pick<DirectoryMission, "status" | "targetMeetings" | "meetings" | "startDate" | "endDate">[], now = Date.now()): PaceVerdict | null {
+    let worst: PaceVerdict | null = null;
+    for (const mission of missions) {
+        if (mission.status !== "ACTIVE") continue;
+        const verdict = pace({ target: mission.targetMeetings, meetings: mission.meetings, startDate: mission.startDate, endDate: mission.endDate, now }).verdict;
+        if (worst === null || PACE_SEVERITY[verdict] < PACE_SEVERITY[worst]) worst = verdict;
+    }
+    return worst;
+}
+
+const STATUS_ORDER: Record<string, number> = { ACTIVE: 0, PAUSED: 1, STOPPED: 2 };
+
+/** Most urgent « À traiter » rank of a client; null when nothing is open. */
+export function topAttentionRank(client: DirectoryClient, now = Date.now()): number | null {
+    return collectAttention([client], now)[0]?.rank ?? null;
+}
+
+/**
+ * Filter + sort the portfolio. Missing values (no engagement, no attention)
+ * stay last whatever the direction; ties fall back to the name.
+ */
+export function applyDirectory(clients: DirectoryClient[], params: Pick<DirectoryParams, "q" | "status" | "sort" | "dir">, now = Date.now()): DirectoryClient[] {
+    const ranks = new Map<string, number | null>();
+    const rankOf = (client: DirectoryClient) => {
+        if (!ranks.has(client.id)) ranks.set(client.id, topAttentionRank(client, now));
+        return ranks.get(client.id)!;
+    };
+    const filtered = clients.filter((client) => {
+        if (!matchesQuery(client, params.q)) return false;
+        if (params.status === "ALL") return true;
+        if (params.status === "ATTENTION") return rankOf(client) !== null;
+        return client.status === params.status;
+    });
+
+    const key = (client: DirectoryClient): number | null => {
+        switch (params.sort) {
+            case "status": return STATUS_ORDER[client.status] ?? 9;
+            case "missions": return client.metrics.runningMissions * 10_000 + client.metrics.totalMissions;
+            case "meetings": return client.metrics.meetingsThisMonth;
+            case "pace": return client.metrics.worstPace ? paceSeverity(client.metrics.worstPace) : null;
+            case "engagementEnd": return client.metrics.engagementEnd ? Date.parse(client.metrics.engagementEnd) : null;
+            case "attention": return rankOf(client);
+            default: return null;
+        }
+    };
+    const sign = params.dir === "desc" ? -1 : 1;
+    const byName = (a: DirectoryClient, b: DirectoryClient) => a.name.localeCompare(b.name, "fr") || a.id.localeCompare(b.id);
+    if (params.sort === "name") return filtered.sort((a, b) => sign * byName(a, b));
+    return filtered
+        .map((client) => ({ client, value: key(client) }))
+        .sort((a, b) => {
+            if (a.value === null || b.value === null) {
+                if (a.value !== b.value) return a.value === null ? 1 : -1;
+                return byName(a.client, b.client);
+            }
+            return sign * (a.value - b.value) || byName(a.client, b.client);
+        })
+        .map(({ client }) => client);
+}
diff --git a/lib/manager/workspace/directory/types.ts b/lib/manager/workspace/directory/types.ts
new file mode 100644
index 0000000..4ba4b0a
--- /dev/null
+++ b/lib/manager/workspace/directory/types.ts
@@ -0,0 +1,117 @@
+// Wire types and query parameters of GET /api/clients?view=workspace — the
+// manager « Espace clients » directory. Pure: shared by the route, the
+// fetchers and the views.
+
+import type { PaceVerdict } from "@/lib/missions/pulse";
+import type { MissionReadiness } from "@/lib/missions/readiness";
+import type { ClientAttentionSignals } from "@/lib/manager/attention";
+
+export type DirectoryClientStatus = "ACTIVE" | "PAUSED" | "STOPPED";
+export type DirectoryStatusFilter = "ALL" | DirectoryClientStatus | "ATTENTION";
+export type DirectorySort = "name" | "status" | "missions" | "meetings" | "pace" | "engagementEnd" | "attention";
+export type SortDir = "asc" | "desc";
+
+export const DIRECTORY_STATUS_FILTERS: readonly DirectoryStatusFilter[] = ["ALL", "ATTENTION", "ACTIVE", "PAUSED", "STOPPED"];
+export const DIRECTORY_SORTS: readonly DirectorySort[] = ["name", "status", "missions", "meetings", "pace", "engagementEnd", "attention"];
+/** Enough for any agency's portfolio: the page paints from one request. */
+export const DIRECTORY_PAGE_LIMIT = 500;
+
+export interface DirectoryMission {
+    id: string;
+    name: string;
+    startDate: string | null;
+    endDate: string | null;
+    status: string;
+    isActive: boolean;
+    channels: string[];
+    sdrCount: number;
+    readiness: MissionReadiness;
+    openPoints: number;
+    /** « RDV visés »; null = no numeric target. */
+    targetMeetings: number | null;
+    /** Booked meetings over the whole mission: distinct prospects with a MEETING_BOOKED action (same count as the mission pulse). */
+    meetings: number;
+    lastActionAt: string | null;
+    /** Last CALL action; null = never called. */
+    lastCallAt: string | null;
+}
+
+export interface DirectoryClientMetrics {
+    /** MEETING_BOOKED actions created this calendar month (Paris), same rule as lib/client-insights. */
+    meetingsThisMonth: number;
+    meetingsLastMonth: number;
+    runningMissions: number;
+    totalMissions: number;
+    /** Worst pace() verdict among ACTIVE missions; null without an ACTIVE mission. */
+    worstPace: PaceVerdict | null;
+    /** End of the current ACTIF engagement. */
+    engagementEnd: string | null;
+    lastCallAt: string | null;
+}
+
+export interface DirectoryClient {
+    id: string;
+    name: string;
+    industry?: string;
+    email?: string;
+    phone?: string;
+    status: DirectoryClientStatus;
+    createdAt: string;
+    bookingUrl?: string | null;
+    _count: { missions: number; users: number };
+    missions: DirectoryMission[];
+    metrics: DirectoryClientMetrics;
+    /** Client-level « À traiter » inputs (lib/manager/attention clientAttention). */
+    signals: Required<ClientAttentionSignals>;
+}
+
+export interface DirectoryPagination {
+    total: number;
+    page: number;
+    limit: number;
+    totalPages: number;
+    hasMore: boolean;
+}
+
+export interface DirectoryResponse {
+    data: DirectoryClient[];
+    pagination: DirectoryPagination;
+}
+
+export interface DirectoryParams {
+    q: string;
+    status: DirectoryStatusFilter;
+    sort: DirectorySort;
+    dir: SortDir;
+    page: number;
+    limit: number;
+}
+
+export const DEFAULT_DIRECTORY_PARAMS: DirectoryParams = { q: "", status: "ALL", sort: "name", dir: "asc", page: 1, limit: DIRECTORY_PAGE_LIMIT };
+
+type ParamsLike = { get(name: string): string | null };
+
+/** Unknown values fall back to the defaults: a bad link shows the whole list, never an error. */
+export function parseDirectoryParams(params: ParamsLike): Omit<DirectoryParams, "page" | "limit"> {
+    const status = params.get("status")?.toUpperCase() as DirectoryStatusFilter | undefined;
+    const sort = params.get("sort") as DirectorySort | null;
+    return {
+        q: params.get("q")?.trim().slice(0, 120) ?? "",
+        status: status && DIRECTORY_STATUS_FILTERS.includes(status) ? status : "ALL",
+        sort: sort && DIRECTORY_SORTS.includes(sort) ? sort : "name",
+        dir: params.get("dir") === "desc" ? "desc" : "asc",
+    };
+}
+
+export function directorySearch(params: DirectoryParams): string {
+    const search = new URLSearchParams({ view: "workspace", page: String(params.page), limit: String(params.limit) });
+    if (params.q) search.set("q", params.q);
+    if (params.status !== "ALL") search.set("status", params.status);
+    if (params.sort !== "name") search.set("sort", params.sort);
+    if (params.dir !== "asc") search.set("dir", params.dir);
+    return search.toString();
+}
+
+export function isDefaultDirectoryParams(params: DirectoryParams): boolean {
+    return !params.q && params.status === "ALL" && params.sort === "name" && params.dir === "asc" && params.page === 1;
+}
diff --git a/lib/manager/workspace/mission/api.ts b/lib/manager/workspace/mission/api.ts
new file mode 100644
index 0000000..919c9b4
--- /dev/null
+++ b/lib/manager/workspace/mission/api.ts
@@ -0,0 +1,231 @@
+// Fetchers for the mission workspace. Same URLs, methods and body keys as the
+// raw fetches they replace (see docs/plans/2026-11-13-workspace-action-inventory.md).
+
+import { ApiError, apiGet, apiSend } from "@/lib/manager/workspace/http";
+import type {
+    AssignableUser,
+    CampaignData,
+    CampaignStrategy,
+    EmailTemplate,
+    FeedbackRange,
+    InsightsPeriod,
+    Mailbox,
+    Mission,
+    MissionFeedbackItem,
+    MissionInsights,
+    MissionTemplate,
+    ScriptCompanion,
+    ScriptTab,
+    TemplateFields,
+} from "./types";
+
+/** The server's own message when it gave one, else the caller's French fallback. */
+export function errorText(error: unknown, fallback: string): string {
+    if (error instanceof ApiError && error.message && error.message !== "Erreur réseau, réessayez." && error.message !== "Introuvable") {
+        return error.message;
+    }
+    return fallback;
+}
+
+// ── Mission ──────────────────────────────────────────────────────────────────
+
+export const fetchMission = (missionId: string) => apiGet<Mission>(`/api/missions/${missionId}`);
+
+export const fetchMissionInsights = (missionId: string, period: InsightsPeriod) =>
+    apiGet<MissionInsights>(`/api/missions/${missionId}/insights?period=${period}`);
+
+export const updateMission = (missionId: string, patch: Record<string, unknown>) =>
+    apiSend<Partial<Mission>>(`/api/missions/${missionId}`, "PUT", patch);
+
+export const deleteMission = (missionId: string) => apiSend<unknown>(`/api/missions/${missionId}`, "DELETE");
+
+export const startPortalLaunch = (missionId: string, days: number) =>
+    apiSend<Partial<Mission>>(`/api/missions/${missionId}/portal-launch`, "POST", { days });
+
+export const revealPortalActivity = (missionId: string) =>
+    apiSend<Partial<Mission>>(`/api/missions/${missionId}/portal-launch`, "DELETE");
+
+// ── Team ─────────────────────────────────────────────────────────────────────
+
+export const fetchAssignableUsers = async () => {
+    const data = await apiGet<AssignableUser[]>("/api/users?role=SDR,BUSINESS_DEVELOPER&status=active&limit=200");
+    if (!Array.isArray(data)) throw new Error("Impossible de charger les SDR");
+    return data;
+};
+
+export const assignSdr = (missionId: string, sdrId: string) =>
+    apiSend<{ sdr?: { name?: string } }>(`/api/missions/${missionId}/assign`, "PATCH", { sdrId });
+
+export const unassignSdr = (missionId: string, sdrId: string) =>
+    apiSend<unknown>(`/api/missions/${missionId}/assign?sdrId=${sdrId}`, "DELETE");
+
+// ── Lists ────────────────────────────────────────────────────────────────────
+
+export const patchList = (listId: string, patch: Record<string, unknown>) =>
+    apiSend<Record<string, unknown> | null>(`/api/lists/${listId}`, "PATCH", patch);
+
+export const deleteList = (listId: string) => apiSend<unknown>(`/api/lists/${listId}`, "DELETE");
+
+// ── Feedback ─────────────────────────────────────────────────────────────────
+
+export const fetchMissionFeedback = (missionId: string, range: FeedbackRange) => {
+    const params = new URLSearchParams({ missionId, from: range.from, to: range.to, limit: "300" });
+    return apiGet<MissionFeedbackItem[]>(`/api/manager/sdr-feedback?${params.toString()}`);
+};
+
+// ── Mailboxes ────────────────────────────────────────────────────────────────
+
+export const fetchMailboxes = async (): Promise<Mailbox[]> => {
+    const data = await apiGet<Mailbox[]>("/api/email/mailboxes?includeShared=true", { cache: "no-store" });
+    return Array.isArray(data) ? data.map((mb) => ({ id: mb.id, email: mb.email, displayName: mb.displayName })) : [];
+};
+
+// ── Strategy (campaign) ──────────────────────────────────────────────────────
+
+const EMPTY_COMPANION: ScriptCompanion = {
+    additionalDraft: "",
+    additionalShared: "",
+    aiDraft: "",
+    aiShared: "",
+    aiGeneratedAt: null,
+    defaultTab: "base",
+};
+
+/** Campaign, then its script companion; a companion failure leaves the variants empty. */
+export async function fetchCampaignStrategy(campaignId: string): Promise<CampaignStrategy> {
+    const campaign = await apiGet<CampaignData>(`/api/campaigns/${campaignId}`);
+    let companion = EMPTY_COMPANION;
+    try {
+        const data = await apiGet<Partial<ScriptCompanion> | null>(`/api/campaigns/${campaign.id}/script-companion`);
+        companion = {
+            additionalDraft: data?.additionalDraft || "",
+            additionalShared: data?.additionalShared || "",
+            aiDraft: data?.aiDraft || "",
+            aiShared: data?.aiShared || "",
+            aiGeneratedAt: data?.aiGeneratedAt || null,
+            defaultTab: data?.defaultTab || "base",
+        };
+    } catch {
+        // Variants are optional: keep them empty.
+    }
+    return { campaign, companion };
+}
+
+export const createCampaign = (body: { name: string; missionId: string; icp: string; pitch: string; script?: string }) =>
+    apiSend<CampaignData>("/api/campaigns", "POST", body);
+
+export const updateCampaign = (campaignId: string, body: { icp: string; pitch: string; script: string }) =>
+    apiSend<CampaignData>(`/api/campaigns/${campaignId}`, "PUT", body);
+
+const companionUrl = (campaignId: string) => `/api/campaigns/${campaignId}/script-companion`;
+
+export const saveCompanionDraft = (campaignId: string, kind: "additional" | "ai", draft: string) =>
+    apiSend<unknown>(companionUrl(campaignId), "PUT", { draft, kind });
+
+export const shareCompanion = (campaignId: string, kind: "additional" | "ai", content: string) =>
+    apiSend<unknown>(companionUrl(campaignId), "POST", { content, kind });
+
+export const saveCompanionDefaultTab = (campaignId: string, defaultTab: ScriptTab) =>
+    apiSend<unknown>(companionUrl(campaignId), "PUT", { defaultTab });
+
+/**
+ * The route answers `{ success, data: { refreshed, aiScript } }`. The old
+ * component read `json.refreshed` (outside `data`), so it always announced
+ * « Script IA inchangé »; reading `data` fixes that message.
+ */
+export async function refreshAiScript(campaignId: string): Promise<{ refreshed: boolean }> {
+    const data = await apiSend<{ refreshed?: boolean; aiScript?: string | null }>(companionUrl(campaignId), "PATCH", { force: true, source: "manual" });
+    return { refreshed: Boolean(data?.refreshed && data?.aiScript) };
+}
+
+export interface ScriptSuggestionRequest {
+    channel: string;
+    clientName?: string;
+    missionName: string;
+    campaignName: string;
+    campaignDescription?: string;
+    icp: string;
+    pitch: string;
+}
+
+type ScriptParts = Partial<Record<"intro" | "discovery" | "objection" | "closing", unknown>>;
+
+/** POST /api/ai/mistral/script → up to three whole-script suggestions. */
+export async function generateScriptSuggestions(request: ScriptSuggestionRequest): Promise<string[]> {
+    const data = await apiSend<{ suggestions?: Record<string, string[] | undefined>; script?: ScriptParts }>(
+        "/api/ai/mistral/script",
+        "POST",
+        { ...request, section: "all", suggestionsCount: 3 },
+    );
+    if (!data?.suggestions && !data?.script) throw new ApiError("Impossible de générer le script", 200);
+    const suggestions = data.suggestions || {};
+    const fallback: ScriptParts = data.script || {};
+    const toSingleScript = (source: ScriptParts): string =>
+        ([["Introduction", source.intro], ["Decouverte", source.discovery], ["Objections", source.objection], ["Closing", source.closing]] as const)
+            .map(([label, value]) => (typeof value === "string" && value.trim() ? `--- ${label} ---\n${value.trim()}` : null))
+            .filter((v): v is string => Boolean(v))
+            .join("\n\n");
+    const maxLen = Math.max(
+        suggestions.intro?.length ?? 0,
+        suggestions.discovery?.length ?? 0,
+        suggestions.objection?.length ?? 0,
+        suggestions.closing?.length ?? 0,
+    );
+    return maxLen > 0
+        ? Array.from({ length: maxLen }, (_, idx) =>
+            toSingleScript({
+                intro: suggestions.intro?.[idx] ?? fallback.intro ?? "",
+                discovery: suggestions.discovery?.[idx] ?? fallback.discovery ?? "",
+                objection: suggestions.objection?.[idx] ?? fallback.objection ?? "",
+                closing: suggestions.closing?.[idx] ?? fallback.closing ?? "",
+            })).filter((s) => s.trim().length > 0)
+        : [toSingleScript(fallback)].filter((s) => s.trim().length > 0);
+}
+
+// ── Email templates ──────────────────────────────────────────────────────────
+
+const templatesUrl = (missionId: string) => `/api/missions/${missionId}/templates`;
+
+export const fetchMissionTemplates = async (missionId: string) =>
+    (await apiGet<MissionTemplate[] | null>(templatesUrl(missionId))) || [];
+
+export const fetchSharedTemplates = async () =>
+    (await apiGet<EmailTemplate[] | null>("/api/email/templates?isShared=true")) || [];
+
+export const addMissionTemplate = (missionId: string, templateId: string) =>
+    apiSend<unknown>(templatesUrl(missionId), "POST", { templateId });
+
+export const createMissionTemplate = (missionId: string, fields: TemplateFields) =>
+    apiSend<unknown>(templatesUrl(missionId), "POST", { createNew: true, ...fields });
+
+export const updateMissionTemplate = (missionId: string, templateId: string, fields: TemplateFields) =>
+    apiSend<unknown>(templatesUrl(missionId), "PATCH", { action: "update", templateId, ...fields });
+
+export const duplicateMissionTemplate = (missionId: string, templateId: string) =>
+    apiSend<unknown>(templatesUrl(missionId), "PATCH", { action: "duplicate", templateId });
+
+export const removeMissionTemplate = (missionId: string, templateId: string) =>
+    apiSend<unknown>(`${templatesUrl(missionId)}?templateId=${templateId}`, "DELETE");
+
+export const reorderMissionTemplates = (missionId: string, templates: MissionTemplate[]) =>
+    apiSend<unknown>(templatesUrl(missionId), "PATCH", {
+        action: "reorder",
+        orders: templates.map((mt, i) => ({ missionTemplateId: mt.id, order: i + 1 })),
+    });
+
+export interface TemplateAiRequest {
+    instruction: string;
+    subject?: string;
+    category: string;
+    missionName?: string;
+    clientName?: string;
+    icp?: string;
+    pitch?: string;
+    currentBody?: string;
+}
+
+export const generateTemplateBody = async (request: TemplateAiRequest) => {
+    const data = await apiSend<{ bodyHtml?: string; suggestedSubject?: string }>("/api/ai/mistral/email-template", "POST", request);
+    if (!data?.bodyHtml) throw new ApiError("Impossible de générer le template", 200);
+    return { bodyHtml: data.bodyHtml, suggestedSubject: data.suggestedSubject };
+};
diff --git a/lib/manager/workspace/mission/mutations.ts b/lib/manager/workspace/mission/mutations.ts
new file mode 100644
index 0000000..53e3183
--- /dev/null
+++ b/lib/manager/workspace/mission/mutations.ts
@@ -0,0 +1,227 @@
+"use client";
+
+// React Query writes for the mission workspace. Each hook owns the cache side
+// (optimistic patch, rollback, invalidation of the narrowest key); the calling
+// component owns the copy (toasts). Switches are optimistic: list active,
+// contacts view, 24 h pause, assign / unassign SDR, status.
+
+import { useMutation, useQueryClient, type QueryClient } from "@tanstack/react-query";
+import * as api from "./api";
+import { missionKeys } from "./queries";
+import type { AssignableUser, Mission, MissionList, MissionTemplate, ScriptTab, TemplateFields } from "./types";
+
+type BriefSnapshot = { previous: Mission | undefined };
+
+/** Reload the mission (lists, strategies and team are read from it in Phase 2). */
+export function invalidateMission(queryClient: QueryClient, missionId: string) {
+    return queryClient.invalidateQueries({ queryKey: missionKeys.brief(missionId), exact: true });
+}
+
+function setBrief(queryClient: QueryClient, missionId: string, update: (mission: Mission) => Mission) {
+    queryClient.setQueryData<Mission>(missionKeys.brief(missionId), (mission) => (mission ? update(mission) : mission));
+}
+
+/** Cancel in-flight reads, keep the current mission for rollback, apply the optimistic change. */
+async function optimistic(queryClient: QueryClient, missionId: string, update: (mission: Mission) => Mission): Promise<BriefSnapshot> {
+    await queryClient.cancelQueries({ queryKey: missionKeys.brief(missionId), exact: true });
+    const previous = queryClient.getQueryData<Mission>(missionKeys.brief(missionId));
+    setBrief(queryClient, missionId, update);
+    return { previous };
+}
+
+function rollback(queryClient: QueryClient, missionId: string, context: BriefSnapshot | undefined) {
+    if (context?.previous) queryClient.setQueryData(missionKeys.brief(missionId), context.previous);
+}
+
+// ── Mission ──────────────────────────────────────────────────────────────────
+
+/** PUT a partial mission (framing fields, référent), then reload it. */
+export function useUpdateMission(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: (patch: Record<string, unknown>) => api.updateMission(missionId, patch),
+        onSuccess: () => invalidateMission(queryClient, missionId),
+    });
+}
+
+/** Status change: optimistic, no reload (the answer carries nothing the page shows). */
+export function useChangeMissionStatus(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: (status: Mission["status"]) => api.updateMission(missionId, { status }),
+        onMutate: (status) => optimistic(queryClient, missionId, (m) => ({ ...m, status, isActive: status === "ACTIVE" })),
+        onError: (_error, _status, context) => rollback(queryClient, missionId, context),
+    });
+}
+
+/** Mission default mailbox; the select already wrote it into the cache. */
+export function useSaveMissionMailbox(missionId: string) {
+    return useMutation({
+        mutationFn: (defaultMailboxId: string) => api.updateMission(missionId, { defaultMailboxId }),
+    });
+}
+
+export function usePortalLaunch(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: (input: { action: "start"; days: number } | { action: "reveal" }) =>
+            input.action === "start" ? api.startPortalLaunch(missionId, input.days) : api.revealPortalActivity(missionId),
+        onSuccess: (data) => setBrief(queryClient, missionId, (m) => ({ ...m, ...data })),
+    });
+}
+
+export function useDeleteMission(missionId: string) {
+    return useMutation({ mutationFn: () => api.deleteMission(missionId) });
+}
+
+// ── Team ─────────────────────────────────────────────────────────────────────
+
+export function useAssignSdr(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: (user: AssignableUser) => api.assignSdr(missionId, user.id),
+        onMutate: (user) => optimistic(queryClient, missionId, (m) => ({
+            ...m,
+            sdrAssignments: [...m.sdrAssignments, { id: `pending-${user.id}`, sdr: { ...user } }],
+        })),
+        onError: (_error, _user, context) => rollback(queryClient, missionId, context),
+        onSettled: () => invalidateMission(queryClient, missionId),
+    });
+}
+
+export function useUnassignSdr(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: (sdrId: string) => api.unassignSdr(missionId, sdrId),
+        onMutate: (sdrId) => optimistic(queryClient, missionId, (m) => ({
+            ...m,
+            sdrAssignments: m.sdrAssignments.filter((a) => a.sdr.id !== sdrId),
+        })),
+        onError: (_error, _sdrId, context) => rollback(queryClient, missionId, context),
+        onSettled: () => invalidateMission(queryClient, missionId),
+    });
+}
+
+// ── Lists ────────────────────────────────────────────────────────────────────
+
+export type ListSwitch = Partial<Pick<MissionList, "isActive" | "contactsViewEnabled" | "queueCooldownEnabled">>;
+
+/** One of a list's switches: optimistic, rolled back on error, mission reloaded after. */
+export function useListSwitch(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: ({ list, patch }: { list: MissionList; patch: ListSwitch }) => api.patchList(list.id, patch),
+        onMutate: ({ list, patch }) => optimistic(queryClient, missionId, (m) => ({
+            ...m,
+            lists: m.lists.map((row) => (row.id === list.id ? { ...row, ...patch } : row)),
+        })),
+        onError: (_error, _vars, context) => rollback(queryClient, missionId, context),
+        onSettled: () => invalidateMission(queryClient, missionId),
+    });
+}
+
+export function useSaveListCommercials(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: ({ listId, ids }: { listId: string; ids: string[] }) => api.patchList(listId, { commercialInterlocuteurIds: ids }),
+        onSuccess: () => invalidateMission(queryClient, missionId),
+    });
+}
+
+export function useAssignCommercialToAllLists(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: ({ listIds, interlocuteurId }: { listIds: string[]; interlocuteurId: string }) =>
+            Promise.all(listIds.map((id) => api.patchList(id, { commercialInterlocuteurId: interlocuteurId }))),
+        onSuccess: () => invalidateMission(queryClient, missionId),
+    });
+}
+
+export function useDeleteList(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: (listId: string) => api.deleteList(listId),
+        onSuccess: () => { void invalidateMission(queryClient, missionId); },
+    });
+}
+
+// ── Strategy (campaign) ──────────────────────────────────────────────────────
+
+export function useCreateStrategy(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: api.createCampaign,
+        onSuccess: () => invalidateMission(queryClient, missionId),
+    });
+}
+
+/** Writes on one campaign; `reload` waits for campaign + companion to come back. */
+export function useCampaignWrite<TInput>(
+    missionId: string,
+    campaignId: string | undefined,
+    write: (campaignId: string, input: TInput) => Promise<unknown>,
+    reload: "await" | "background" | "none",
+) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: (input: TInput) => {
+            if (!campaignId) return Promise.reject(new Error("Campagne introuvable"));
+            return write(campaignId, input);
+        },
+        onSuccess: () => {
+            if (reload === "none" || !campaignId) return;
+            const done = queryClient.invalidateQueries({ queryKey: missionKeys.strategy(missionId, campaignId) });
+            return reload === "await" ? done : undefined;
+        },
+    });
+}
+
+export const writeCampaign = (campaignId: string, input: { icp: string; pitch: string; script: string }) => api.updateCampaign(campaignId, input);
+export const writeCompanionDraft = (campaignId: string, input: { kind: "additional" | "ai"; text: string }) => api.saveCompanionDraft(campaignId, input.kind, input.text);
+export const writeCompanionShare = (campaignId: string, input: { kind: "additional" | "ai"; text: string }) => api.shareCompanion(campaignId, input.kind, input.text);
+export const writeCompanionDefaultTab = (campaignId: string, tab: ScriptTab) => api.saveCompanionDefaultTab(campaignId, tab);
+export const writeAiRefresh = (campaignId: string) => api.refreshAiScript(campaignId);
+
+export function useGenerateScriptSuggestions() {
+    return useMutation({ mutationFn: api.generateScriptSuggestions });
+}
+
+// ── Email templates ──────────────────────────────────────────────────────────
+
+/** Template writes reload the mission's template list in the background. */
+function useTemplateWrite<TInput>(missionId: string, write: (input: TInput) => Promise<unknown>) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: write,
+        onSuccess: () => { void queryClient.invalidateQueries({ queryKey: missionKeys.templates(missionId), exact: true }); },
+    });
+}
+
+export const useAddTemplate = (missionId: string) =>
+    useTemplateWrite(missionId, (templateId: string) => api.addMissionTemplate(missionId, templateId));
+
+export const useCreateTemplate = (missionId: string) =>
+    useTemplateWrite(missionId, (fields: TemplateFields) => api.createMissionTemplate(missionId, fields));
+
+export const useUpdateTemplate = (missionId: string) =>
+    useTemplateWrite(missionId, ({ templateId, fields }: { templateId: string; fields: TemplateFields }) =>
+        api.updateMissionTemplate(missionId, templateId, fields));
+
+export const useDuplicateTemplate = (missionId: string) =>
+    useTemplateWrite(missionId, (templateId: string) => api.duplicateMissionTemplate(missionId, templateId));
+
+export const useRemoveTemplate = (missionId: string) =>
+    useTemplateWrite(missionId, (templateId: string) => api.removeMissionTemplate(missionId, templateId));
+
+/** Drag reorder: the list moves at once; a failed save stays silent, as before. */
+export function useReorderTemplates(missionId: string) {
+    const queryClient = useQueryClient();
+    return useMutation({
+        mutationFn: (templates: MissionTemplate[]) => api.reorderMissionTemplates(missionId, templates),
+        onMutate: (templates) => { queryClient.setQueryData(missionKeys.templates(missionId), templates); },
+    });
+}
+
+export function useGenerateTemplateBody() {
+    return useMutation({ mutationFn: api.generateTemplateBody });
+}
diff --git a/lib/manager/workspace/mission/queries.ts b/lib/manager/workspace/mission/queries.ts
