+// Fetchers of the client workspace. Each wraps one existing route through
+// lib/manager/workspace/http (unwraps { success, data, error }, throws the
+// French message). URLs and bodies are the ones ClientDrawer.tsx and the
+// legacy ClientDetailWorkspace sent — see docs/plans/2026-11-13-workspace-action-inventory.md.
+
+import { apiGet, apiSend, ApiError } from "@/lib/manager/workspace/http";
+import type { ChecklistView } from "@/lib/onboarding/checklist-service";
+import type {
+    BillingOffer,
+    ClientDetail,
+    ClientSession,
+    CreateSessionInput,
+    LeexiTranscription,
+    Mailbox,
+    UpdateSessionInput,
+} from "./types";
+
+// ── Client ──────────────────────────────────────────────────────────────────
+
+export const fetchClientDetail = (clientId: string) => apiGet<ClientDetail>(`/api/clients/${clientId}`);
+
+export const fetchOnboardingChecklist = (clientId: string) =>
+    apiGet<ChecklistView | null>(`/api/clients/${clientId}/onboarding-checklist`);
+
+/** Missing or failed list → empty, as before: the select then offers « Aucune ». */
+export async function fetchMailboxes(): Promise<Mailbox[]> {
+    try {
+        const data = await apiGet<unknown>("/api/email/mailboxes?includeShared=true");
+        return Array.isArray(data) ? (data as Mailbox[]) : [];
+    } catch {
+        return [];
+    }
+}
+
+export const updateClient = (clientId: string, patch: Record<string, unknown>) =>
+    apiSend<unknown>(`/api/clients/${clientId}`, "PUT", patch);
+
+export const deleteClient = (clientId: string) => apiSend<unknown>(`/api/clients/${clientId}`, "DELETE");
+
+export const updateMissionPlan = (planId: string, body: { frequency: number; preferredDays: string[] }) =>
+    apiSend<unknown>(`/api/mission-plans/${planId}`, "PUT", body);
+
+export const updateMissionStatus = (missionId: string, status: string) =>
+    apiSend<unknown>(`/api/missions/${missionId}`, "PATCH", { status });
+
+// ── Engagement ──────────────────────────────────────────────────────────────
+
+export const updateEngagement = (engagementId: string, patch: Record<string, unknown>) =>
+    apiSend<unknown>(`/api/billing/engagements/${engagementId}`, "PATCH", patch);
+
+export const createEngagement = (body: { clientId: string; offreTarifId: string; dureeMois: number; debut: string }) =>
+    apiSend<unknown>("/api/billing/engagements", "POST", body);
+
+export async function fetchSelectableOffers(): Promise<BillingOffer[]> {
+    const data = await apiGet<unknown>("/api/billing/offres").catch(() => null);
+    return Array.isArray(data) ? (data as BillingOffer[]) : [];
+}
+
+// ── Sessions & comptes rendus ───────────────────────────────────────────────
+
+export const fetchClientSessions = (clientId: string) => apiGet<ClientSession[]>(`/api/clients/${clientId}/sessions`);
+
+export async function fetchLeexiTranscriptions(clientId: string): Promise<LeexiTranscription[]> {
+    try {
+        return await apiGet<LeexiTranscription[]>(`/api/leexi/transcriptions?clientId=${clientId}`);
+    } catch (cause) {
+        throw new Error(cause instanceof ApiError ? cause.message || "Impossible de charger les transcriptions" : "Erreur de connexion à Leexi");
+    }
+}
+
+export async function fetchLeexiTranscript(leexiId: string): Promise<string> {
+    const data = await apiGet<{ transcript: string }>(`/api/leexi/transcript/${leexiId}`);
+    return data.transcript;
+}
+
+/** POST /api/ai/generate-cr → the model's raw text (CR, separator, e-mail). */
+export async function generateCR(prompt: string): Promise<string> {
+    const data = await apiSend<{ text: string }>("/api/ai/generate-cr", "POST", { prompt });
+    return data.text;
+}
+
+/**
+ * POST /api/clients/:id/sessions. `emailSent` and `projectId` sit next to
+ * `data` in this route's envelope, so it is read here instead of through
+ * apiSend (which keeps only `data`).
+ */
+export async function createClientSession(clientId: string, body: CreateSessionInput): Promise<{ session: ClientSession; emailSent: boolean; projectId: string | null }> {
+    const res = await fetch(`/api/clients/${clientId}/sessions`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(body),
+    });
+    let json: { success?: boolean; data?: ClientSession; error?: string; emailSent?: boolean; projectId?: string | null } | null = null;
+    try {
+        json = await res.json();
+    } catch {
+        // Non-JSON answer.
+    }
+    if (!json?.success) throw new ApiError(json?.error || "Impossible d'enregistrer la session", res.status);
+    return { session: json.data as ClientSession, emailSent: !!json.emailSent, projectId: json.projectId ?? null };
+}
+
+export const updateClientSession = (clientId: string, sessionId: string, body: UpdateSessionInput) =>
+    apiSend<{ projectId?: string | null }>(`/api/clients/${clientId}/sessions/${sessionId}`, "PATCH", body);
+
+export const deleteClientSession = (clientId: string, sessionId: string) =>
+    apiSend<{ deleted: true }>(`/api/clients/${clientId}/sessions/${sessionId}`, "DELETE");
+
+export const toggleSessionTask = (clientId: string, sessionId: string, taskId: string) =>
+    apiSend<{ taskId: string; doneAt: string | null }>(`/api/clients/${clientId}/sessions/${sessionId}`, "PATCH", { toggleTaskId: taskId });
