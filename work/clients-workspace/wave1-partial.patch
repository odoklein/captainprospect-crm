@@ -0,0 +1,66 @@
+"use client";
+
+// What the client views derive from the detail payload. Pure apart from the
+// hook wrapper, so the shell and each view read the same rules.
+
+import { useMemo } from "react";
+import { missionAttention, type AttentionEntry } from "@/lib/manager/attention";
+import type { WorkspaceClient, WorkspaceMission } from "@/components/manager/workspace/InboxItem";
+import type {
+    Client,
+    ClientDetail,
+    ClientStatus,
+    ClientUserLite,
+    InterlocuteurLite,
+    MissionLite,
+} from "@/lib/manager/workspace/client/types";
+
+export interface ClientModel {
+    missions: MissionLite[];
+    openMissions: MissionLite[];
+    closedMissions: MissionLite[];
+    usersList: ClientUserLite[];
+    interlocuteurs: InterlocuteurLite[];
+    clientStatus: ClientStatus;
+    /** Launch summaries of the directory row, by mission id. */
+    workspaceMissions: Map<string, WorkspaceMission>;
+    clientAttention: AttentionEntry<WorkspaceMission>[];
+    attentionByMission: Map<string, AttentionEntry<WorkspaceMission>>;
+}
+
+/** Primary e-mail / phone and job title, whatever shape the contact came in. */
+export function normalizeInterlocuteurs(list: InterlocuteurLite[]): InterlocuteurLite[] {
+    return list.map((person) => ({
+        ...person,
+        email: person.emails?.find((entry) => entry.isPrimary)?.value ?? person.emails?.[0]?.value ?? person.email,
+        phone: person.phones?.find((entry) => entry.isPrimary)?.value ?? person.phones?.[0]?.value ?? person.phone,
+        jobTitle: person.title ?? person.jobTitle,
+    }));
+}
+
+export function deriveClientModel(client: Client, detail: ClientDetail | undefined, allClients: WorkspaceClient[]): ClientModel {
+    const missions = (detail?.missions ?? []) as MissionLite[];
+    const closedMissions = missions.filter((mission) => mission.status === "COMPLETED" || mission.status === "ARCHIVED");
+    const openMissions = missions.filter((mission) => !closedMissions.includes(mission));
+    const workspaceMissions = new Map((allClients.find((entry) => entry.id === client.id)?.missions ?? []).map((mission) => [mission.id, mission]));
+    const clientAttention: AttentionEntry<WorkspaceMission>[] = missions.flatMap((mission) => {
+        const summary = workspaceMissions.get(mission.id);
+        const item = summary ? missionAttention(summary) : null;
+        return item && summary ? [{ ...item, clientId: client.id, clientName: client.name, mission: summary }] : [];
+    }).sort((a, b) => a.rank - b.rank);
+    return {
+        missions,
+        openMissions,
+        closedMissions,
+        usersList: (detail?.users ?? []) as ClientUserLite[],
+        interlocuteurs: normalizeInterlocuteurs((detail?.interlocuteurs ?? []) as InterlocuteurLite[]),
+        clientStatus: (detail?.status ?? client.status ?? "ACTIVE") as ClientStatus,
+        workspaceMissions,
+        clientAttention,
+        attentionByMission: new Map(clientAttention.map((item) => [item.mission.id, item])),
+    };
+}
+
+export function useClientModel(client: Client, detail: ClientDetail | undefined, allClients: WorkspaceClient[]) {
+    return useMemo(() => deriveClientModel(client, detail, allClients), [client, detail, allClients]);
+}
