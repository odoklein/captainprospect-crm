+"use client";
+
+// Mission-level dialogs that several places open (header menu, brief, rail,
+// panels): base drawer, CSV import, strategy editor, launch fix, mission
+// options, status workflow, portal launch. This provider owns their open
+// state and renders them; callers only get commands.
+
+import { createContext, useContext, useMemo, useState, type ReactNode } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { MissionStatusWorkflowDrawer } from "@/components/drawers";
+import { CSVImportDialog } from "@/components/dialogs/CSVImportDialog";
+import { MissionAudienceDrawer } from "@/components/missions/MissionAudienceDrawer";
+import { StrategyEditorDrawer } from "@/components/missions/StrategyEditorDrawer";
+import { EditMissionDialog } from "@/components/missions/EditMissionDialog";
+import type { LaunchList, StrategyField } from "@/components/missions/ReadinessPanel";
+import { invalidateMission } from "@/lib/manager/workspace/mission/mutations";
+import { useMission, useMissionWorkspace } from "./context";
+import { PortalLaunchDialog } from "./dialogs/PortalLaunchDialog";
+
+type AudienceTarget = { id: string; name: string } | "new";
+
+export interface MissionCommands {
+    openAudience: (target: AudienceTarget) => void;
+    openCsvImport: () => void;
+    openStrategyEditor: (campaignId: string | "new") => void;
+    openLaunchFix: (field: StrategyField, list: LaunchList) => void;
+    openEditMission: () => void;
+    openStatusWorkflow: () => void;
+    openPortalLaunch: () => void;
+}
+
+const MissionCommandsContext = createContext<MissionCommands | null>(null);
+
+export function useMissionCommands() {
+    const value = useContext(MissionCommandsContext);
+    if (!value) throw new Error("useMissionCommands outside MissionCommandsProvider");
+    return value;
+}
+
+export function MissionCommandsProvider({ children }: { children: ReactNode }) {
+    const mission = useMission();
+    const { missionId, onTabChange, onMissionMutated } = useMissionWorkspace();
+    const queryClient = useQueryClient();
+    const [audiencePanel, setAudiencePanel] = useState<AudienceTarget | null>(null);
+    const [showCsvImport, setShowCsvImport] = useState(false);
+    const [campaignEditor, setCampaignEditor] = useState<string | "new" | null>(null);
+    const [launchFix, setLaunchFix] = useState<{ field: StrategyField; list: LaunchList } | null>(null);
+    const [showEditMission, setShowEditMission] = useState(false);
+    const [showStatusWorkflow, setShowStatusWorkflow] = useState(false);
+    const [showPortalLaunch, setShowPortalLaunch] = useState(false);
+
+    const commands = useMemo<MissionCommands>(() => ({
+        openAudience: setAudiencePanel,
+        openCsvImport: () => setShowCsvImport(true),
+        openStrategyEditor: setCampaignEditor,
+        openLaunchFix: (field, list) => setLaunchFix({ field, list }),
+        openEditMission: () => setShowEditMission(true),
+        openStatusWorkflow: () => setShowStatusWorkflow(true),
+        openPortalLaunch: () => setShowPortalLaunch(true),
+    }), []);
+
+    const reload = () => {
+        void invalidateMission(queryClient, missionId);
+        onMissionMutated?.();
+    };
+
+    return (
+        <MissionCommandsContext.Provider value={commands}>
+            {children}
+
+            {audiencePanel && <MissionAudienceDrawer key={audiencePanel === "new" ? "new" : audiencePanel.id} missionId={mission.id} missionName={mission.name} list={audiencePanel === "new" ? null : audiencePanel} onClose={() => setAudiencePanel(null)} onCreated={setAudiencePanel} onChanged={reload} />}
+            {showCsvImport && <CSVImportDialog isOpen onClose={() => setShowCsvImport(false)} missions={[{ id: mission.id, name: mission.name }]} onSuccess={() => { setShowCsvImport(false); reload(); onTabChange("audience"); }} />}
+            {campaignEditor && <StrategyEditorDrawer isOpen onClose={() => setCampaignEditor(null)} campaignId={campaignEditor === "new" ? null : campaignEditor} missionId={mission.id} lists={mission.lists} onSaved={reload} />}
+            {launchFix && <StrategyEditorDrawer
+                isOpen
+                onClose={() => setLaunchFix(null)}
+                campaignId={launchFix.list.readiness?.inheritedCampaignId ?? launchFix.list.campaignId ?? null}
+                initialAssignToListId={launchFix.field === "strategy" ? launchFix.list.id : undefined}
+                focusField={launchFix.field === "strategy" ? undefined : launchFix.field}
+                missionId={mission.id}
+                lists={mission.lists}
+                onSaved={reload}
+            />}
+
+            <EditMissionDialog
+                isOpen={showEditMission}
+                onClose={() => setShowEditMission(false)}
+                mission={mission}
+                onSaved={reload}
+            />
+
+            <PortalLaunchDialog isOpen={showPortalLaunch} onClose={() => setShowPortalLaunch(false)} />
+
+            {/* Statuts et workflow drawer */}
+            <MissionStatusWorkflowDrawer
+                isOpen={showStatusWorkflow}
+                onClose={() => setShowStatusWorkflow(false)}
+                missionId={mission.id}
+                missionName={mission.name}
+            />
+        </MissionCommandsContext.Provider>
+    );
+}
diff --git a/components/manager/workspace/mission/context.tsx b/components/manager/workspace/mission/context.tsx
new file mode 100644
index 0000000..d9ae973
--- /dev/null
+++ b/components/manager/workspace/mission/context.tsx
@@ -0,0 +1,114 @@
+"use client";
+
+// Mission workspace context: navigation callbacks, the header save state and
+// the framing editor's edit requests. Shared by the shell, the brief and the
+// panels; no panel data lives here (panels read React Query directly).
+
+import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState, type ReactNode } from "react";
+import { useQueryClient } from "@tanstack/react-query";
+import { useToast } from "@/components/ui";
+import type { SetupField } from "@/components/missions/MissionSetupPanel";
+import { errorText } from "@/lib/manager/workspace/mission/api";
+import { useUpdateMission } from "@/lib/manager/workspace/mission/mutations";
+import { missionKeys, useMissionBrief } from "@/lib/manager/workspace/mission/queries";
+import type { Mission } from "@/lib/manager/workspace/mission/types";
+
+export type FieldSaveState = "saving" | "saved" | null;
+
+interface MissionWorkspaceContextValue {
+    missionId: string;
+    onTabChange: (tab: string) => void;
+    onBack: () => void;
+    onMissionMutated?: () => void;
+    /** PUT a partial mission, reload it, flash « Enregistré » and offer an undo when possible. */
+    saveField: (patch: Record<string, unknown>, label: string, options?: { silent?: boolean }) => Promise<boolean>;
+    saveState: FieldSaveState;
+    setupDirty: boolean;
+    setSetupDirty: (dirty: boolean) => void;
+    editRequest: { field: SetupField; at: number } | null;
+    requestEdit: (field: SetupField) => void;
+}
+
+const MissionWorkspaceContext = createContext<MissionWorkspaceContextValue | null>(null);
+
+export function useMissionWorkspace() {
+    const value = useContext(MissionWorkspaceContext);
+    if (!value) throw new Error("useMissionWorkspace outside MissionWorkspaceProvider");
+    return value;
+}
+
+/** The loaded mission. Only rendered under the shell, which waits for it. */
+export function useMission(): Mission {
+    const { missionId } = useMissionWorkspace();
+    return useMissionBrief(missionId).data as Mission;
+}
+
+/** Previous values the API accepts back (it rejects null dates), for « Annuler ». */
+function previousValues(mission: Mission, patch: Record<string, unknown>) {
+    const previous: Record<string, unknown> = {};
+    for (const key of Object.keys(patch)) {
+        if (key === "name") previous.name = mission.name;
+        else if (key === "startDate" && mission.startDate) previous.startDate = mission.startDate.slice(0, 10);
+        else if (key === "endDate" && mission.endDate) previous.endDate = mission.endDate.slice(0, 10);
+        else if (key === "defaultInterlocuteurId") previous.defaultInterlocuteurId = mission.defaultInterlocuteur?.id ?? null;
+    }
+    return previous;
+}
+
+export function MissionWorkspaceProvider({ missionId, onTabChange, onBack, onMissionMutated, children }: {
+    missionId: string;
+    onTabChange: (tab: string) => void;
+    onBack: () => void;
+    onMissionMutated?: () => void;
+    children: ReactNode;
+}) {
+    const { error: showError, addToast } = useToast();
+    const queryClient = useQueryClient();
+    const update = useUpdateMission(missionId);
+    const [saveState, setSaveState] = useState<FieldSaveState>(null);
+    const [setupDirty, setSetupDirty] = useState(false);
+    const [editRequest, setEditRequest] = useState<{ field: SetupField; at: number } | null>(null);
+    const savedTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+    useEffect(() => () => {
+        if (savedTimerRef.current) clearTimeout(savedTimerRef.current);
+    }, []);
+
+    const saveField = useCallback(async (patch: Record<string, unknown>, label: string, options?: { silent?: boolean }): Promise<boolean> => {
+        const mission = queryClient.getQueryData<Mission>(missionKeys.brief(missionId));
+        if (!mission) return false;
+        const previous = previousValues(mission, patch);
+        setSaveState("saving");
+        try {
+            await update.mutateAsync(patch);
+        } catch (error) {
+            setSaveState(null);
+            showError("Erreur", errorText(error, `Impossible de modifier « ${label} »`));
+            return false;
+        }
+        onMissionMutated?.();
+        setSaveState("saved");
+        if (savedTimerRef.current) clearTimeout(savedTimerRef.current);
+        savedTimerRef.current = setTimeout(() => setSaveState(null), 1800);
+        if (!options?.silent) {
+            const canUndo = Object.keys(previous).length === Object.keys(patch).length;
+            addToast({
+                type: "success",
+                title: `${label} mis à jour`,
+                ...(canUndo ? { action: { label: "Annuler", onClick: () => { void saveField(previous, label, { silent: true }); } } } : {}),
+            });
+        }
+        return true;
+        // `update.mutateAsync` is stable across renders.
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [missionId, onMissionMutated, queryClient, showError, addToast]);
+
+    const requestEdit = useCallback((field: SetupField) => setEditRequest({ field, at: Date.now() }), []);
+
+    const value = useMemo<MissionWorkspaceContextValue>(() => ({
+        missionId, onTabChange, onBack, onMissionMutated,
+        saveField, saveState, setupDirty, setSetupDirty, editRequest, requestEdit,
+    }), [missionId, onTabChange, onBack, onMissionMutated, saveField, saveState, setupDirty, editRequest, requestEdit]);
+
+    return <MissionWorkspaceContext.Provider value={value}>{children}</MissionWorkspaceContext.Provider>;
+}
