+"use client";
+
+// Writes of the client workspace. Same requests and same toasts as the
+// drawer they come from; invalidation is the client detail + directory list
+// (what every write refetched before). Simple switches (client status, portal
+// permissions, session tasks) are optimistic with rollback + error toast.
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { useToast } from "@/components/ui";
+import { CLIENTS_QUERY_KEY, clientDetailQueryKey } from "@/lib/query-keys";
+import { MISSION_STATUS_CONFIG, type MissionStatusValue } from "@/lib/constants/missionStatus";
+import { createClientPage, clientPagesKey, type ClientPageSummary } from "@/components/manager/workspace/clientPages";
+import type { PageTemplate } from "@/lib/client-pages/blocks";
+import {
+    createEngagement,
+    deleteClient,
+    updateClient,
+    updateEngagement,
+    updateMissionPlan,
+    updateMissionStatus,
+} from "./api";
+import type { Client, ClientDetail, MissionLite, MissionPlanLite } from "./types";
+
+/** The route's message, or the drawer's own fallback when the API gave none. */
+export function messageOf(error: unknown, fallback: string) {
+    const message = error instanceof Error ? error.message : "";
+    return !message || message === "Erreur réseau, réessayez." || message === "Introuvable" ? fallback : message;
+}
+
+/** Refetch what any client write can change: the detail and the directory row. */
+export function useRefreshClient(clientId: string) {
+    const queryClient = useQueryClient();
+    return () => {
+        void queryClient.invalidateQueries({ queryKey: clientDetailQueryKey(clientId) });
+        void queryClient.invalidateQueries({ queryKey: CLIENTS_QUERY_KEY });
+    };
+}
+
+// Fields the API stores in onboarding.onboardingData rather than on the client.
+const ONBOARDING_FIELDS = new Set(["icp", "defaultMailboxId", "portalAllowExport"]);
+
+function mergeIntoDetail(detail: ClientDetail | undefined, patch: Record<string, unknown>): ClientDetail | undefined {
+    if (!detail) return detail;
+    const top: Record<string, unknown> = {};
+    const onboarding: Record<string, unknown> = {};
+    for (const [key, value] of Object.entries(patch)) (ONBOARDING_FIELDS.has(key) ? onboarding : top)[key] = value;
+    return {
+        ...detail,
+        ...top,
+        onboarding: Object.keys(onboarding).length
+            ? { ...(detail.onboarding ?? {}), onboardingData: { ...(detail.onboarding?.onboardingData ?? {}), ...onboarding } }
+            : detail.onboarding,
+    };
+}
+
+/**
+ * PUT /api/clients/:id with one changed field. `mutateAsync` rejects on error
+ * so inline fields stay in edit mode, as before.
+ */
+export function useUpdateClient(client: Client, onUpdate?: (client: Client) => void) {
+    const queryClient = useQueryClient();
+    const { success, error: showError } = useToast();
+    const refresh = useRefreshClient(client.id);
+    const key = clientDetailQueryKey(client.id);
+    return useMutation({
+        mutationFn: ({ patch }: { patch: Record<string, unknown>; optimistic?: boolean }) => updateClient(client.id, patch),
+        onMutate: async ({ patch, optimistic }) => {
+            if (!optimistic) return undefined;
+            await queryClient.cancelQueries({ queryKey: key });
+            const previous = queryClient.getQueryData<ClientDetail>(key);
+            queryClient.setQueryData<ClientDetail | undefined>(key, (detail) => mergeIntoDetail(detail, patch));
+            const before = Object.fromEntries(Object.keys(patch).map((field) => [field, (client as unknown as Record<string, unknown>)[field]]));
+            onUpdate?.({ ...client, ...patch } as Client);
+            return { previous, before };
+        },
+        onError: (cause, _vars, context) => {
+            if (context) {
+                queryClient.setQueryData(key, context.previous);
+                onUpdate?.({ ...client, ...context.before } as Client);
+            }
+            showError("Erreur", messageOf(cause, "Impossible de mettre à jour"));
+        },
+        onSuccess: (_data, { patch }) => {
+            success("Mis à jour", "Modifications enregistrées");
+            onUpdate?.({ ...client, ...patch } as Client);
+        },
+        onSettled: refresh,
+    });
+}
+
+export function useDeleteClient(client: Client, onDone: () => void) {
+    const { success, error: showError } = useToast();
+    const refresh = useRefreshClient(client.id);
+    return useMutation({
+        mutationFn: () => deleteClient(client.id),
+        onSuccess: () => {
+            success("Client supprimé", `${client.name} et toutes les données associées ont été supprimés`);
+            refresh();
+            onDone();
+        },
+        onError: (cause) => showError("Erreur", messageOf(cause, "Impossible de supprimer le client")),
+    });
+}
+
+const WEEKDAYS = ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"];
+
+/** Days per week of a mission plan; keeps the chosen days, pads with weekdays. */
+export function useUpdatePlanFrequency(clientId: string) {
+    const { success, error: showError } = useToast();
+    const refresh = useRefreshClient(clientId);
+    return useMutation({
+        mutationFn: ({ plan, frequency }: { plan: MissionPlanLite; frequency: number }) => {
+            const currentDays = plan.preferredDays ?? [];
+            const preferredDays = [...currentDays, ...WEEKDAYS.filter((day) => !currentDays.includes(day))].slice(0, frequency);
+            return updateMissionPlan(plan.id, { frequency, preferredDays });
+        },
+        onSuccess: (_data, { frequency }) => {
+            success("Planning mis à jour", `${frequency} jour${frequency > 1 ? "s" : ""} / semaine enregistré`);
+            refresh();
+        },
+        onError: (cause) => showError("Erreur", messageOf(cause, "Impossible de mettre à jour le planning")),
+    });
+}
+
+/** Mission status from the client home (the API enforces canTransitionMissionStatus). */
+export function useUpdateMissionStatus(clientId: string) {
+    const { success, error: showError } = useToast();
+    const refresh = useRefreshClient(clientId);
+    return useMutation({
+        mutationFn: ({ mission, status }: { mission: MissionLite; status: MissionStatusValue }) => updateMissionStatus(mission.id, status),
+        onSuccess: (_data, { mission, status }) => {
+            success("Statut mis à jour", `${mission.name} : ${MISSION_STATUS_CONFIG[status].label}`);
+            refresh();
+        },
+        onError: (cause) => showError("Statut inchangé", messageOf(cause, "Changement de statut refusé")),
+    });
+}
+
+export function useUpdateEngagementField(clientId: string, engagementId: string | null | undefined) {
+    const { success, error: showError } = useToast();
+    const refresh = useRefreshClient(clientId);
+    return useMutation({
+        mutationFn: (patch: Record<string, unknown>) => updateEngagement(engagementId!, patch),
+        onSuccess: () => {
+            success("Engagement mis à jour", "Modifications enregistrées");
+            refresh();
+        },
+        onError: (cause) => showError("Erreur", messageOf(cause, "Impossible de mettre à jour l’engagement")),
+    });
+}
+
+/** « Créer un engagement » / « Renouveler » modal. */
+export function useSaveEngagement(clientId: string, onSaved: () => void) {
+    const { success, error: showError } = useToast();
+    const refresh = useRefreshClient(clientId);
+    return useMutation({
+        mutationFn: (input:
+            | { mode: "create"; offreTarifId: string; dureeMois: number; debut: string }
+            | { mode: "renew"; engagementId: string; dureeMois: number; debut: string }) =>
+            input.mode === "create"
+                ? createEngagement({ clientId, offreTarifId: input.offreTarifId, dureeMois: input.dureeMois, debut: input.debut })
+                : updateEngagement(input.engagementId, { nouveauDebut: input.debut, nouvelleDureeMois: input.dureeMois }),
+        onSuccess: (_data, input) => {
+            if (input.mode === "create") success("Engagement créé", "Le nouvel engagement a été enregistré");
+            else success("Engagement renouvelé", "Les nouvelles dates ont été enregistrées");
+            onSaved();
+            refresh();
+        },
+        onError: (cause, input) => showError("Erreur", messageOf(cause, input.mode === "create" ? "Impossible de créer l’engagement" : "Impossible de renouveler l’engagement")),
+    });
+}
+
+/** New page from a template; appended to the pages cache, then opened. */
+export function useCreateClientPage(clientId: string, onCreated: (page: ClientPageSummary) => void) {
+    const queryClient = useQueryClient();
+    const { error: showError } = useToast();
+    return useMutation({
+        mutationFn: ({ template, missionId }: { template: PageTemplate; missionId?: string | null }) => createClientPage(clientId, { template, missionId }),
+        onSuccess: (page) => {
+            queryClient.setQueryData(clientPagesKey(clientId), (list: ClientPageSummary[] | undefined) => [...(list ?? []), page]);
+            onCreated(page);
+        },
+        onError: (cause) => showError("Page non créée", (cause as Error).message),
+    });
+}
diff --git a/lib/manager/workspace/client/queries.ts b/lib/manager/workspace/client/queries.ts
new file mode 100644
index 0000000..c253222
--- /dev/null
+++ b/lib/manager/workspace/client/queries.ts
@@ -0,0 +1,66 @@
+"use client";
+
+// React Query reads of the client workspace. Keys are the ones the drawer
+// already used, so caches shared with other components (OnboardingChecklist,
+// WeeklyBilanModal, the directory page) keep working.
+
+import { useQuery } from "@tanstack/react-query";
+import { clientDetailQueryKey, clientSessionsQueryKey } from "@/lib/query-keys";
+import { onboardingChecklistKey } from "@/components/onboarding/OnboardingChecklist";
+import {
+    fetchClientDetail,
+    fetchClientSessions,
+    fetchLeexiTranscriptions,
+    fetchMailboxes,
+    fetchOnboardingChecklist,
+    fetchSelectableOffers,
+} from "./api";
+
+export const MANAGER_MAILBOXES_KEY = ["manager", "mailboxes"] as const;
+export const SELECTABLE_OFFERS_KEY = ["billing", "offres", "selectable"] as const;
+export const leexiTranscriptionsKey = (clientId: string) => ["leexi", "transcriptions", clientId] as const;
+
+export function useClientDetail(clientId: string | null | undefined, enabled = true) {
+    return useQuery({
+        queryKey: clientDetailQueryKey(clientId ?? null),
+        queryFn: () => fetchClientDetail(clientId!),
+        enabled: enabled && !!clientId,
+    });
+}
+
+/** Onboarding progress (tree badge, home rail) — same cache as the checklist itself. */
+export function useOnboardingProgress(clientId: string | null | undefined, enabled = true) {
+    return useQuery({
+        queryKey: onboardingChecklistKey(clientId ?? ""),
+        queryFn: () => fetchOnboardingChecklist(clientId!),
+        enabled: enabled && !!clientId,
+        staleTime: 30_000,
+    });
+}
+
+export function useMailboxes(enabled = true) {
+    return useQuery({ queryKey: MANAGER_MAILBOXES_KEY, queryFn: fetchMailboxes, enabled, staleTime: 60_000 });
+}
+
+export function useSelectableOffers(enabled: boolean) {
+    return useQuery({ queryKey: SELECTABLE_OFFERS_KEY, queryFn: fetchSelectableOffers, enabled, staleTime: 60_000 });
+}
+
+export function useClientSessions(clientId: string | null | undefined, enabled = true) {
+    return useQuery({
+        queryKey: clientSessionsQueryKey(clientId),
+        queryFn: () => fetchClientSessions(clientId!),
+        enabled: enabled && !!clientId,
+    });
+}
+
+/** Loaded each time the « Nouvelle session » modal opens (staleTime 0), as before. */
+export function useLeexiTranscriptions(clientId: string, enabled: boolean) {
+    return useQuery({
+        queryKey: leexiTranscriptionsKey(clientId),
+        queryFn: () => fetchLeexiTranscriptions(clientId),
+        enabled,
+        staleTime: 0,
+        retry: false,
+    });
+}
